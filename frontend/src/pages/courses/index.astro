---
import App from '../../layouts/App.astro';
---
<App title="Catalogue" activePage="catalogue">

  <div class="cat-outer">
  <div class="page-inner">

    <h1 class="cat-page-title">Catalogue</h1>

    <!-- Toolbar -->
    <div class="flex items-center gap-2.5 mb-3.5 flex-wrap">
      <div class="relative flex-1 min-w-[160px] max-w-[420px]">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-soft pointer-events-none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input class="input js-cat-search pl-9 w-full h-[38px] text-[.875rem] backdrop-blur-[8px]" type="search" placeholder="Rechercher un cours…" />
      </div>
      <select class="input js-diff-filter cat-diff-filter">
        <option value="">Toutes difficultés</option>
        <option value="beginner">Débutant</option>
        <option value="intermediate">Intermédiaire</option>
        <option value="advanced">Avancé</option>
      </select>
      <span class="cat-count-label" id="count-label"></span>
    </div>

    <!-- Active skill filter banner (only when ?skill= param is set) -->
    <div class="skill-filter-banner" id="skill-filter-banner" style="display:none">
      <span>🎯 Cours adaptés à ton niveau — <span id="skill-filter-label"></span></span>
      <button onclick="clearSkillFilter()">✕ Retirer le filtre</button>
    </div>

    <!-- Category chips -->
    <div class="cat-chips" id="cat-chips" style="display:none"></div>

    <!-- Loading -->
    <div id="loading" class="loading-state">
      <div class="spinner"></div>
      <span>Chargement des cours…</span>
    </div>

    <!-- Content -->
    <div id="cat-content" style="display:none">
      <!-- Continue hero -->
      <div id="continue-hero"></div>

      <!-- Empty state -->
      <div id="empty" class="cat-empty" style="display:none">
        <div class="cat-empty-icon">📭</div>
        <h3 class="cat-empty-title">Aucun cours trouvé</h3>
        <p class="text-soft text-sm">Essayez d'ajuster votre recherche ou vos filtres</p>
      </div>

      <!-- Courses grid -->
      <div id="groups-container"></div>
    </div>
  </div>
  </div>

  <script>
    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error((err as any).error || `HTTP ${res.status}`); }
      return res.json();
    }

    const token = localStorage.getItem('token');
    let allCourses: any[] = [];
    let enrolledCourses: any[] = [];
    let enrolledIds = new Set<string>();
    let searchTimer: ReturnType<typeof setTimeout>;
    let selectedCategories = new Set<string>();
    let activeDiff: string | null = null;

    // ── Skill level filter (via ?skill= URL param) ────────────────────
    let mySkillLevels: { skill: string; level: string }[] = [];
    const urlParams = new URLSearchParams(window.location.search);
    let activeSkillFilter: string | null = urlParams.get('skill');

    const LEVEL_ORDER: Record<string, number> = { beginner: 1, intermediate: 2, advanced: 3 };
    const LEVEL_LABEL: Record<string, string> = { beginner: 'Débutant', intermediate: 'Intermédiaire', advanced: 'Avancé' };

    function matchesSkillFilter(course: any): boolean {
      if (!activeSkillFilter) return true;
      const skills: string[] = course.skills ?? [];
      if (!skills.includes(activeSkillFilter)) return false;
      const entry = mySkillLevels.find(s => s.skill === activeSkillFilter);
      if (!entry) return true;
      const userOrder = LEVEL_ORDER[entry.level] ?? 1;
      const courseOrder = LEVEL_ORDER[course.difficulty] ?? 0;
      return courseOrder >= userOrder;
    }

    function updateSkillBanner() {
      const banner = document.getElementById('skill-filter-banner')!;
      const label = document.getElementById('skill-filter-label')!;
      if (!activeSkillFilter) { banner.style.display = 'none'; return; }
      const entry = mySkillLevels.find(s => s.skill === activeSkillFilter);
      const levelText = entry ? ` (${LEVEL_LABEL[entry.level] ?? entry.level} et +)` : '';
      label.textContent = `${activeSkillFilter}${levelText}`;
      banner.style.display = 'flex';
    }

    // ── Difficulty labels ──────────────────────────────────────────────
    const diffLabels: Record<string, string> = { beginner: 'Débutant', intermediate: 'Intermédiaire', advanced: 'Avancé' };
    const diffColors: Record<string, string> = { beginner: 'badge-green', intermediate: 'badge-orange', advanced: 'badge-red' };

    // ── Category display metadata ──────────────────────────────────────
    const CAT_META: Record<string, { label: string; icon: string }> = {
      linux:            { label: 'Linux',           icon: '🐧' },
      devops:           { label: 'DevOps',           icon: '⚙️'  },
      kubernetes:       { label: 'Kubernetes',       icon: '☸️'  },
      docker:           { label: 'Docker',           icon: '🐋' },
      networking:       { label: 'Réseaux',          icon: '🌐' },
      security:         { label: 'Sécurité',         icon: '🛡️' },
      programming:      { label: 'Programmation',    icon: '💻' },
      python:           { label: 'Python',           icon: '🐍' },
      git:              { label: 'Git',              icon: '🔀' },
      cloud:            { label: 'Cloud',            icon: '☁️'  },
      database:         { label: 'Base de données',  icon: '🗄️'  },
      'internal-testing': { label: 'Tests internes', icon: '🧪' },
    };

    function getCatLabel(slug: string): string {
      return CAT_META[slug]?.label ?? slug.charAt(0).toUpperCase() + slug.slice(1).replace(/-/g, ' ');
    }
    function getCatIcon(slug: string): string {
      return CAT_META[slug]?.icon ?? '📖';
    }

    function courseThumbIcon(c: any): string {
      if (c.thumbnail) return '';
      const tags = [c.category || '', ...(c.skills || [])].join(' ').toLowerCase();
      if (/pentest|hack|exploit|cyber|vuln|ctf/.test(tags))      return '🔐';
      if (/security|sécurité|secure/.test(tags))                  return '🛡️';
      if (/linux|unix|bash|shell/.test(tags))                     return '🐧';
      if (/git|gitlab|github|ci.?cd|devops|pipeline/.test(tags)) return '⚙️';
      if (/docker|container|podman/.test(tags))                   return '🐋';
      if (/kubernetes|k8s|helm/.test(tags))                       return '☸️';
      if (/python/.test(tags))                                    return '🐍';
      if (/network|réseau|tcp|ip|wifi/.test(tags))               return '🌐';
      if (/cloud|aws|azure|gcp/.test(tags))                       return '☁️';
      if (/database|sql|postgres|mysql/.test(tags))               return '🗄️';
      if (/web|http|html|css|frontend/.test(tags))                return '🌍';
      if (/javascript|typescript|node/.test(tags))                return '📦';
      if (/go|golang/.test(tags))                                  return '🦫';
      return getCatIcon(c.category || '');
    }

    // ── Color palette per category group ──────────────────────────────
    const GROUP_PALETTE = [
      { bg: 'var(--blue-soft)',  border: 'var(--blue)',   dot: '#1b86f2', thumbBg: '#dbeeff' },
      { bg: 'var(--orange-soft)',border: 'var(--orange)', dot: '#ff9d18', thumbBg: '#fff0d0' },
      { bg: 'var(--good-soft)',  border: 'var(--good)',   dot: '#3bb273', thumbBg: '#d2f0e1' },
      { bg: '#ede9fe',           border: '#7c3aed',       dot: '#7c3aed', thumbBg: '#e5dcff' },
      { bg: '#fce7f3',           border: '#db2777',       dot: '#db2777', thumbBg: '#fad4e8' },
      { bg: '#e0f7fa',           border: '#0891b2',       dot: '#0891b2', thumbBg: '#cff0f7' },
      { bg: 'var(--bad-soft)',   border: 'var(--bad)',    dot: '#e5534b', thumbBg: '#fcd5d3' },
      { bg: '#eef2ff',           border: '#4f46e5',       dot: '#4f46e5', thumbBg: '#dde2ff' },
    ];

    const catColorIndex = new Map<string, number>();

    function getCatColor(cat: string) {
      if (!catColorIndex.has(cat)) catColorIndex.set(cat, catColorIndex.size % GROUP_PALETTE.length);
      return GROUP_PALETTE[catColorIndex.get(cat)!];
    }

    // ── Render course card ─────────────────────────────────────────────
    function renderCourseCard(c: any, color: typeof GROUP_PALETTE[0]): string {
      const enrolled = enrolledIds.has(c.id);
      const diff = c.difficulty
        ? `<span class="badge ${diffColors[c.difficulty] || 'badge-blue'}">${diffLabels[c.difficulty] || c.difficulty}</span>`
        : '';
      const skillChips = (c.skills ?? []).slice(0, 3).map((s: string) =>
        `<a href="/skills/${s}" class="badge badge-purple text-[.65rem] no-underline">🎯 ${s}</a>`).join('');
      const inPersonBadge = c.inPerson
        ? `<span class="badge badge-inperson text-[.65rem]">🏢 Présentiel</span>`
        : '';
      const xpGate = c.xpRequired > 0
        ? `<span class="badge badge-orange" title="${c.xpRequired} XP requis">⚡ ${c.xpRequired} XP requis</span>`
        : '';
      const xpReward = `<span class="badge badge-xp-reward text-[.65rem]">+200 XP</span>`;
      const prog = enrolled
        ? `<div class="rail-card-prog"><div class="rail-card-prog-fill" style="width:100%"></div></div>`
        : '';
      const thumbContent = c.thumbnail
        ? `<img src="${c.thumbnail}" alt="${c.title}" />`
        : `<span class="text-[2rem]">${courseThumbIcon(c)}</span>`;
      const catLabel = getCatLabel(c.category || '');
      const catIcon  = getCatIcon(c.category || '');

      return `
        <div class="rail-card" style="--cat-color:${color.dot}" onclick="goToCourse('${c.id}')">
          <div class="rail-card-thumb-wrap">
            <div class="rail-card-thumb" style="background:${color.thumbBg};">${thumbContent}</div>
            <span class="rail-card-cat">${catIcon} ${catLabel}</span>
          </div>
          <div class="rail-card-body">
            <div class="rail-card-title">${c.title}</div>
            <div class="rail-card-footer">${diff}${inPersonBadge}${xpGate}${xpReward}${skillChips}</div>
            ${prog}
          </div>
        </div>
      `;
    }

    // ── Render continue hero ───────────────────────────────────────────
    function renderContinueHero(course: any): string {
      const thumb = course.thumbnail ? `<img src="${course.thumbnail}" alt="${course.title}" />` : courseThumbIcon(course);
      const labsDone = course.completedLabs ?? 0;
      const labsTotal = course.labCount ?? 0;
      const pct = labsTotal > 0 ? Math.round(labsDone / labsTotal * 100) : 0;
      return `
        <div class="continue-hero" onclick="goToCourse('${course.id}')">
          <div class="continue-thumb">${thumb}</div>
          <div class="continue-meta">
            <div class="continue-badge">Reprendre</div>
            <div class="continue-title">${course.title}</div>
            <div class="continue-prog"><div class="continue-prog-fill" style="width:${pct}%"></div></div>
            <div class="continue-sub">${labsDone}/${labsTotal} modules · ${pct}%</div>
          </div>
          <button class="continue-btn" onclick="event.stopPropagation();goToCourse('${course.id}')">Continuer ▸</button>
        </div>
      `;
    }

    // ── Render chips ───────────────────────────────────────────────────
    function renderChips(slugs: string[]) {
      const chipsEl = document.getElementById('cat-chips')!;
      if (slugs.length < 2) { chipsEl.style.display = 'none'; return; }
      chipsEl.style.display = 'flex';

      const hasFilter = selectedCategories.size > 0;
      const resetClass = 'chip-reset' + (hasFilter ? ' has-filter' : '');

      const resetBtn = `<button class="${resetClass}" onclick="clearCats()">Tout</button>`;

      const chips = slugs.map(slug => {
        const color = getCatColor(slug);
        const isActive = selectedCategories.has(slug);
        const count = allCourses.filter(c => (c.category || '') === slug).length;
        const style = isActive
          ? `background:${color.dot};border-color:${color.dot};`
          : '';
        return `
          <button class="cat-chip${isActive ? ' active' : ''}" style="${style}"
                  data-cat="${slug}" onclick="toggleCat('${slug}')">
            <span class="chip-dot" style="background:${color.dot};${isActive ? 'background:#fff8;' : ''}"></span>
            ${getCatLabel(slug)}
            <span class="chip-count">${count}</span>
          </button>
        `;
      }).join('');

      chipsEl.innerHTML = resetBtn + chips;
    }

    // ── Render groups ──────────────────────────────────────────────────
    function renderGroups(courses: any[], search: string) {
      const q = search.toLowerCase().trim();
      let filtered = q
        ? courses.filter(c =>
            c.title.toLowerCase().includes(q) ||
            (c.description || '').toLowerCase().includes(q) ||
            (c.category || '').toLowerCase().includes(q)
          )
        : courses;

      const activeCats = Array.from(selectedCategories);
      let visible = (activeCats.length > 0
        ? filtered.filter(c => activeCats.includes(c.category || ''))
        : filtered).filter(matchesSkillFilter);

      if (activeDiff) visible = visible.filter(c => c.difficulty === activeDiff);

      const sorted = [...visible].sort((a, b) =>
        a.title.localeCompare(b.title, 'fr', { sensitivity: 'base' }));

      const countLabel = document.getElementById('count-label')!;
      countLabel.textContent = sorted.length > 0 ? `${sorted.length} cours` : '';

      if (sorted.length === 0) {
        document.getElementById('empty')!.style.display = 'block';
        document.getElementById('groups-container')!.innerHTML = '';
        return;
      }
      document.getElementById('empty')!.style.display = 'none';

      const cards = sorted.map(c => renderCourseCard(c, getCatColor(c.category || ''))).join('');
      document.getElementById('groups-container')!.innerHTML =
        `<div class="courses-grid-lg">${cards}</div>`;
    }

    function rerender() {
      const q = (document.querySelector<HTMLInputElement>('.js-cat-search')?.value) || '';
      const allSlugs = Array.from(new Set(allCourses.map(c => c.category || '').filter(Boolean)));
      renderChips(allSlugs);
      renderGroups(allCourses, q);
    }

    (window as any).goToCourse = (id: string) => { window.location.href = `/courses/${id}`; };

    (window as any).toggleCat = (cat: string) => {
      if (selectedCategories.has(cat)) selectedCategories.delete(cat);
      else selectedCategories.add(cat);
      rerender();
    };

    (window as any).clearCats = () => {
      selectedCategories.clear();
      rerender();
    };

    (window as any).clearSkillFilter = () => {
      activeSkillFilter = null;
      const url = new URL(window.location.href);
      url.searchParams.delete('skill');
      window.history.replaceState({}, '', url.toString());
      updateSkillBanner();
      rerender();
    };

    async function loadAll() {
      document.getElementById('loading')!.style.display = 'flex';
      try {
        const [coursesRes, enrolledRes, skillsRes] = await Promise.allSettled([
          apiFetch('/courses'),
          token ? apiFetch('/my/courses', { token: token! }) : Promise.resolve({ courses: [] }),
          token ? apiFetch('/my/skills', { token: token! }) : Promise.resolve({ skills: [] }),
        ]);

        if (coursesRes.status === 'fulfilled') {
          allCourses = (coursesRes.value as any).courses || [];
        }
        if (enrolledRes.status === 'fulfilled') {
          enrolledCourses = (enrolledRes.value as any).courses || [];
          enrolledIds = new Set(enrolledCourses.map((c: any) => c.id));
        }
        if (skillsRes.status === 'fulfilled') {
          mySkillLevels = (skillsRes.value as any).skills || [];
          updateSkillBanner();
        }

        // Continue hero: in-progress first, then most recent enrolled
        const heroContainer = document.getElementById('continue-hero')!;
        const inProgress = enrolledCourses.filter((c: any) => {
          const p = c.labCount > 0 ? c.completedLabs / c.labCount : 0;
          return p > 0 && p < 1;
        });
        const heroTarget = inProgress[0] ?? enrolledCourses[0] ?? null;
        if (heroTarget) heroContainer.innerHTML = renderContinueHero(heroTarget);

        // Seed stable color assignments before first render
        const allSlugs = Array.from(new Set(allCourses.map((c: any) => c.category || '').filter(Boolean)));
        allSlugs.forEach(s => getCatColor(s));

        renderChips(allSlugs);
        renderGroups(allCourses, '');
        document.getElementById('cat-content')!.style.display = 'block';
      } catch { /* leave empty */ } finally {
        document.getElementById('loading')!.style.display = 'none';
      }
    }

    const searchEl = document.querySelector<HTMLInputElement>('.js-cat-search')!;
    searchEl?.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => renderGroups(allCourses, searchEl.value), 280);
    });

    const diffEl = document.querySelector<HTMLSelectElement>('.js-diff-filter')!;
    diffEl?.addEventListener('change', () => {
      activeDiff = diffEl.value || null;
      rerender();
    });

    loadAll();
  </script>
</App>
