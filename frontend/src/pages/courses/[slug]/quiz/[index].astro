---
import App from '../../../../layouts/App.astro';
---
<App title="Quiz">

  <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement du quiz…</span></div>

  <!-- Main quiz layout -->
  <div id="quiz-wrap" style="display:none">
    <!-- Breadcrumb -->
    <div id="breadcrumb" class="quiz-breadcrumb"></div>

    <div class="quiz-page-layout">
      <!-- Left: all questions -->
      <div class="quiz-main">
        <h1 id="quiz-title" class="quiz-title-head"></h1>
        <p id="quiz-subtitle" class="text-soft text-sm quiz-subtitle-text"></p>
        <div id="questions-container"></div>
        <!-- Mobile submit (below questions) -->
        <button id="submit-btn-bottom" class="btn btn-primary btn-lg w-full mt-2">Soumettre le quiz</button>
      </div>

      <!-- Right: palette -->
      <div class="quiz-palette">
        <div class="palette-label">Navigation</div>
        <div id="palette-chips" class="palette-chips"></div>
        <div class="palette-progress-wrap">
          <div class="palette-progress-row">
            <span>Répondues</span>
            <span id="palette-answered-count">0 / 0</span>
          </div>
          <div class="progress-bar"><div id="palette-progress-fill" class="progress-bar-fill" style="width:0%"></div></div>
        </div>
        <button id="submit-btn" class="btn btn-primary btn-lg w-full">Soumettre le quiz</button>
        <p class="text-soft text-[.78rem]">Cliquez sur un numéro pour accéder directement à la question.</p>
      </div>
    </div>
  </div>

  <!-- Result screen (replaces quiz-wrap) -->
  <div id="result-screen" style="display:none">
    <div class="result-screen">
      <div id="result-hero" class="result-hero">
        <div id="score-circle" class="score-circle">
          <div id="score-num" class="score-num"></div>
          <div id="score-den" class="score-den"></div>
        </div>
        <div class="flex-1">
          <h2 id="result-title" class="mb-1.5"></h2>
          <p id="result-subtitle" class="text-soft text-sm result-subtitle"></p>
          <div id="result-badges" class="result-badges"></div>
        </div>
        <img src="/pioupitre.png" alt="" class="w-20 h-20 object-contain flex-none">
      </div>
      <div id="result-actions" class="result-actions"></div>
      <div id="question-review" class="result-review"></div>
    </div>
  </div>

  <script>
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const slug = pathParts[1];
    const moduleIndex = parseInt(pathParts[3], 10);

    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname); }

    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        const e = new Error((err as any).error || `HTTP ${res.status}`) as any;
        e.status = res.status;
        e.body = err;
        throw e;
      }
      return res.json();
    }

    // ── Pattern rendering ──────────────────────────────────────────────────────
    let _patternCache: Record<string, { html: string; css: string }> | null = null;

    async function loadPatterns(): Promise<Record<string, { html: string; css: string }>> {
      if (_patternCache) return _patternCache;
      try {
        const res = await fetch('/api/patterns');
        if (!res.ok) return (_patternCache = {});
        const data = await res.json() as any;
        const map: Record<string, { html: string; css: string }> = {};
        for (const p of (data.patterns || [])) map[p.name] = { html: p.html || '', css: p.css || '' };
        _patternCache = map;
      } catch { _patternCache = {}; }
      return _patternCache!;
    }

    function injectPatternCSS(patterns: Record<string, { html: string; css: string }>) {
      let styleEl = document.getElementById('pattern-styles') as HTMLStyleElement | null;
      if (!styleEl) { styleEl = document.createElement('style'); styleEl.id = 'pattern-styles'; document.head.appendChild(styleEl); }
      styleEl.textContent = Object.values(patterns).map(p => p.css).filter(Boolean).join('\n');
    }

    async function applyPatterns(md: string, patterns: Record<string, { html: string; css: string }>, markedInst: any): Promise<string> {
      if (!Object.keys(patterns).length) return md;
      const norm = md.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      let out = norm;
      for (const [name, pat] of Object.entries(patterns)) {
        if (!pat.html) continue;
        const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`\\|\\|\\|${esc}\\n([\\s\\S]*?)\\n\\|\\|\\|`, 'g');
        const hits: Array<{ full: string; content: string }> = [];
        let m: RegExpExecArray | null;
        while ((m = re.exec(norm)) !== null) hits.push({ full: m[0], content: m[1] });
        for (const hit of hits) {
          const inner = await markedInst.parseInline(hit.content.trim());
          out = out.replace(hit.full, pat.html.replace(/\{\{content\}\}/g, inner));
        }
      }
      for (const [name, pat] of Object.entries(patterns)) {
        if (!pat.html) continue;
        const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        out = out.replace(
          new RegExp(`\\|\\|\\|${esc} ([^|\\n]+?)\\|\\|\\|`, 'g'),
          (_, content: string) => pat.html.replace(/\{\{content\}\}/g, content.trim())
        );
      }
      return out;
    }

    async function renderMarkdown(md: string): Promise<string> {
      const { marked } = await import('marked');
      const patterns = await loadPatterns();
      injectPatternCSS(patterns);
      const processed = await applyPatterns(md, patterns, marked);
      return marked.parse(processed) as string;
    }

    let quiz: any = null;
    let questions: any[] = [];
    let answers: Record<string, any> = {};
    let allModules: any[] = [];
    let submitted = false;
    let result: any = null;
    let cooldowns: Record<string, { remaining: number; locked: boolean }> = {};
    let cooldownTimer: ReturnType<typeof setInterval> | null = null;

    // Track which question card is "focused" (most visible in viewport)
    let focusedQ = 0;

    // ── Cookie-based cooldown persistence ──────────────────────────────────────
    function saveCooldownsToCookie(moduleIdx: number, cds: Record<string, { remaining: number; locked: boolean }>) {
      const data: Record<string, number> = {};
      const now = Date.now();
      for (const [qid, cd] of Object.entries(cds)) {
        if (cd.locked) data[qid] = -1;
        else if (cd.remaining > 0) data[qid] = now + cd.remaining * 1000;
      }
      const name = `pcd_${slug}_${moduleIdx}`;
      if (Object.keys(data).length === 0) {
        document.cookie = `${name}=; max-age=0; path=/; SameSite=Strict`;
      } else {
        document.cookie = `${name}=${encodeURIComponent(JSON.stringify(data))}; max-age=86400; path=/; SameSite=Strict`;
      }
    }

    function loadCooldownsFromCookie(moduleIdx: number): Record<string, any> | null {
      const name = `pcd_${slug}_${moduleIdx}`;
      const match = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith(name + '='));
      if (!match) return null;
      try {
        const data: Record<string, number> = JSON.parse(decodeURIComponent(match.slice(name.length + 1)));
        const now = Date.now();
        const out: Record<string, any> = {};
        let hasActive = false;
        for (const [qid, exp] of Object.entries(data)) {
          if (exp === -1) {
            out[qid] = { remainingSeconds: 0, locked: true }; hasActive = true;
          } else {
            const r = Math.max(0, Math.round((exp - now) / 1000));
            if (r > 0) { out[qid] = { remainingSeconds: r, locked: false }; hasActive = true; }
          }
        }
        return hasActive ? out : null;
      } catch { return null; }
    }
    // ───────────────────────────────────────────────────────────────────────────

    async function init() {
      if (!token) return;
      try {
        const [modRes, quizMod] = await Promise.all([
          apiFetch(`/courses/${slug}/modules`, { token: token! }),
          apiFetch(`/courses/${slug}/modules/${moduleIndex}`, { token: token! }),
        ]);
        allModules = (modRes as any).modules || [];
        quiz = quizMod;
        const currentMod = allModules.find((m: any) => m.index === moduleIndex);
        if (currentMod?.locked) { window.location.href = `/courses/${slug}`; return; }

        // Inline quizzes are embedded in the previous lesson — redirect there
        if (quiz.inline) {
          const prevMod = allModules.slice(0, allModules.findIndex((m: any) => m.index === moduleIndex)).filter((m: any) => !m.inline).at(-1);
          window.location.replace(prevMod ? `/courses/${slug}/lessons/${prevMod.index}` : `/courses/${slug}`);
          return;
        }

        questions = quiz.questions || [];
        const initCd = quiz.cooldowns || loadCooldownsFromCookie(moduleIndex);
        if (initCd) startCooldowns(initCd);

        for (const q of questions) {
          if (q.type === 'single') answers[q.id] = '';
          else if (q.type === 'multiple') answers[q.id] = [];
          else if (q.type === 'boolean') answers[q.id] = null;
          else if (q.type === 'order') answers[q.id] = (q.items || []).map((i: any) => i.id);
        }
      } catch (e: any) {
        if (e.status === 403) { window.location.href = `/courses/${slug}`; return; }
        document.getElementById('loading')!.innerHTML = '<div class="text-center py-16"><h2>Quiz introuvable</h2><a href="/courses" class="btn btn-primary mt-4 inline-flex">Catalogue</a></div>';
        return;
      }

      document.title = `${quiz.name} — pupitre`;

      document.getElementById('breadcrumb')!.innerHTML = `
        <a href="/courses">Catalogue</a>
        <span>›</span>
        <a href="/courses/${slug}">${slug}</a>
        <span>›</span>
        <span>${quiz.name}</span>
      `;
      document.getElementById('quiz-title')!.textContent = quiz.name;
      document.getElementById('quiz-subtitle')!.textContent = `${questions.length} question${questions.length !== 1 ? 's' : ''}`;

      document.getElementById('loading')!.style.display = 'none';
      document.getElementById('quiz-wrap')!.style.display = 'block';

      renderAllQuestions();
      updatePalette();

      // Intersection observer to track focused question
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const idx = parseInt((entry.target as HTMLElement).dataset.idx || '0', 10);
            if (!isNaN(idx)) { focusedQ = idx; updatePalette(); }
          }
        }
      }, { threshold: 0.5 });
      document.querySelectorAll('.quiz-q-card').forEach(el => io.observe(el));

      document.getElementById('submit-btn')!.addEventListener('click', submitQuiz);
      document.getElementById('submit-btn-bottom')!.addEventListener('click', submitQuiz);
    }

    function startCooldowns(cds: Record<string, any>) {
      cooldowns = {};
      for (const [k, cd] of Object.entries(cds)) {
        cooldowns[k] = { remaining: (cd as any).remainingSeconds, locked: (cd as any).locked };
      }
      saveCooldownsToCookie(moduleIndex, cooldowns);
      if (cooldownTimer) clearInterval(cooldownTimer);
      cooldownTimer = setInterval(() => {
        let any = false;
        for (const k of Object.keys(cooldowns)) {
          if (cooldowns[k].remaining > 0) { cooldowns[k].remaining--; any = true; }
        }
        if (!any && cooldownTimer) { clearInterval(cooldownTimer); cooldownTimer = null; }
        updateCooldownBanners();
      }, 1000);
    }

    function isAnswered(q: any): boolean {
      const v = answers[q.id];
      if (q.type === 'single') return !!v;
      if (q.type === 'multiple') return Array.isArray(v) && v.length > 0;
      if (q.type === 'boolean') return v !== null && v !== undefined;
      if (q.type === 'order') return Array.isArray(v) && v.length > 0;
      return false;
    }

    function updatePalette() {
      const answeredCount = questions.filter(q => isAnswered(q)).length;
      const pct = questions.length > 0 ? Math.round(answeredCount / questions.length * 100) : 0;

      document.getElementById('palette-answered-count')!.textContent = `${answeredCount} / ${questions.length}`;
      (document.getElementById('palette-progress-fill') as HTMLElement).style.width = pct + '%';

      const chips = document.getElementById('palette-chips')!;
      chips.innerHTML = questions.map((q, i) => {
        let cls = 'palette-chip';
        if (i === focusedQ) cls += ' current';
        else if (isAnswered(q)) cls += ' answered';
        return `<div class="${cls}" onclick="scrollToQuestion(${i})">${i + 1}</div>`;
      }).join('');

      // Update card borders
      questions.forEach((q) => {
        const card = document.getElementById(`q-card-${q.id}`);
        if (card) card.classList.toggle('has-answer', isAnswered(q));
      });
    }

    (window as any).scrollToQuestion = (idx: number) => {
      const card = document.getElementById(`q-card-${questions[idx]?.id}`);
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        focusedQ = idx;
        updatePalette();
      }
    };

    function renderQuestionOptions(q: any): string {
      const cd = cooldowns[q.id];
      const disabled = (submitted && !canRetry()) || (cd && (cd.locked || cd.remaining > 0));

      if (q.type === 'single') {
        return `<div class="quiz-options">
          ${(q.answers || []).map((a: any) => `
            <button type="button" class="quiz-option${answers[q.id] === a.id ? ' selected' : ''}" data-qid="${q.id}" data-aid="${a.id}" data-type="single" ${disabled ? 'disabled' : ''}>
              <span class="radio-circle"></span>
              <span>${a.text}</span>
            </button>
          `).join('')}
        </div>`;
      }

      if (q.type === 'multiple') {
        return `<div class="quiz-options">
          ${(q.answers || []).map((a: any) => {
            const checked = Array.isArray(answers[q.id]) && answers[q.id].includes(a.id);
            return `
              <button type="button" class="quiz-option${checked ? ' selected' : ''}" data-qid="${q.id}" data-aid="${a.id}" data-type="multiple" ${disabled ? 'disabled' : ''}>
                <span class="quiz-cb ${checked ? 'checked' : ''}">${checked ? '<span class="quiz-cb-check">✓</span>' : ''}</span>
                <span>${a.text}</span>
              </button>
            `;
          }).join('')}
        </div>`;
      }

      if (q.type === 'boolean') {
        return `<div class="flex gap-3">
          ${[{ v: 'true', label: 'Vrai' }, { v: 'false', label: 'Faux' }].map(opt => `
            <button type="button" class="quiz-option flex-1 justify-center${answers[q.id] === (opt.v === 'true') ? ' selected' : ''}" data-qid="${q.id}" data-bool="${opt.v}" data-type="boolean" ${disabled ? 'disabled' : ''}>
              ${opt.label}
            </button>
          `).join('')}
        </div>`;
      }

      if (q.type === 'order') {
        const items = q.items || [];
        const order: string[] = Array.isArray(answers[q.id]) ? answers[q.id] : items.map((i: any) => i.id);
        return `<div class="quiz-options" id="order-${q.id}">
          ${order.map((id: string, idx: number) => {
            const item = items.find((i: any) => i.id === id);
            return `
              <div class="order-item" draggable="true" data-qid="${q.id}" data-id="${id}">
                <span class="drag-handle">⠿</span>
                <span class="order-num">${idx + 1}.</span>
                <span class="order-text">${item?.text || id}</span>
                <div class="order-btns">
                  <button type="button" class="order-move-btn" onclick="moveOrder('${q.id}',${idx},-1)" ${idx === 0 ? 'disabled' : ''}>↑</button>
                  <button type="button" class="order-move-btn" onclick="moveOrder('${q.id}',${idx},1)" ${idx === order.length - 1 ? 'disabled' : ''}>↓</button>
                </div>
              </div>
            `;
          }).join('')}
        </div>`;
      }

      return '';
    }

    function renderAllQuestions() {
      const container = document.getElementById('questions-container')!;
      container.innerHTML = questions.map((q, i) => {
        const cd = cooldowns[q.id];
        const cdBanner = cd && (cd.locked || cd.remaining > 0)
          ? `<div class="cooldown-banner" id="cd-${q.id}">${cd.locked ? '🔒 Question verrouillée' : `⏳ Réessayez dans ${cd.remaining}s`}</div>`
          : '';
        return `
          <div class="quiz-q-card${isAnswered(q) ? ' has-answer' : ''}" id="q-card-${q.id}" data-idx="${i}">
            <div class="quiz-q-header">
              <span class="qnum-chip">Q${i + 1}</span>
              <div class="quiz-q-text">${q.question}</div>
              <span class="quiz-q-points">${q.points} pt${q.points > 1 ? 's' : ''}</span>
            </div>
            ${cdBanner}
            ${renderQuestionOptions(q)}
          </div>
        `;
      }).join('');

      // Bind drag for order questions
      questions.forEach(q => { if (q.type === 'order') bindOrderDrag(q.id); });

      // Delegated click handler
      container.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button.quiz-option') as HTMLButtonElement;
        if (!btn || btn.disabled) return;

        const qid = btn.dataset.qid!;
        const type = btn.dataset.type!;

        if (type === 'single') {
          answers[qid] = btn.dataset.aid!;
        } else if (type === 'multiple') {
          const arr = Array.isArray(answers[qid]) ? [...answers[qid]] : [];
          const idx = arr.indexOf(btn.dataset.aid!);
          if (idx >= 0) arr.splice(idx, 1); else arr.push(btn.dataset.aid!);
          answers[qid] = arr;
        } else if (type === 'boolean') {
          answers[qid] = btn.dataset.bool === 'true';
        }

        // Re-render the card content (delegated handler stays on container)
        const card = document.getElementById(`q-card-${qid}`);
        const qi = questions.findIndex(q => q.id === qid);
        if (card && qi >= 0) {
          const q = questions[qi];
          const cd = cooldowns[q.id];
          const cdBanner = cd && (cd.locked || cd.remaining > 0)
            ? `<div class="cooldown-banner" id="cd-${q.id}">${cd.locked ? '🔒 Question verrouillée' : `⏳ Réessayez dans ${cd.remaining}s`}</div>`
            : '';
          card.innerHTML = `
            <div class="quiz-q-header">
              <span class="qnum-chip">Q${qi + 1}</span>
              <div class="quiz-q-text">${q.question}</div>
              <span class="quiz-q-points">${q.points} pt${q.points > 1 ? 's' : ''}</span>
            </div>
            ${cdBanner}
            ${renderQuestionOptions(q)}
          `;
          card.classList.toggle('has-answer', isAnswered(q));
        }
        updatePalette();
      });
    }

    function updateCooldownBanners() {
      for (const [qid, cd] of Object.entries(cooldowns)) {
        const banner = document.getElementById(`cd-${qid}`);
        if (banner) {
          if (cd.locked) {
            banner.textContent = '🔒 Question verrouillée';
          } else if (cd.remaining > 0) {
            banner.textContent = `⏳ Réessayez dans ${cd.remaining}s`;
          } else {
            banner.style.display = 'none';
          }
        }
      }
    }

    function canRetry() {
      if (!result || result.passed) return false;
      for (const cd of Object.values(cooldowns)) { if (cd.remaining > 0 || cd.locked) return false; }
      return true;
    }

    async function submitQuiz() {
      const payload: Record<string, any> = {};
      for (const q of questions) {
        const val = answers[q.id];
        if (q.type === 'single') payload[q.id] = { single: val || null };
        else if (q.type === 'multiple') payload[q.id] = { multiple: val };
        else if (q.type === 'boolean') payload[q.id] = { boolean: val };
        else if (q.type === 'order') payload[q.id] = { order: val };
      }

      const btns = document.querySelectorAll<HTMLButtonElement>('#submit-btn, #submit-btn-bottom');
      btns.forEach(b => { b.disabled = true; b.textContent = 'Envoi…'; });

      try {
        result = await apiFetch(`/courses/${slug}/modules/${moduleIndex}/submit`, {
          method: 'POST', body: { answers: payload }, token: token!,
        }) as any;
        submitted = true;
        startCooldowns(result.cooldowns || {});
        showResult();
      } catch (e: any) {
        if (e.status === 425 && e.body?.cooldowns) startCooldowns(e.body.cooldowns);
        (window as any).showToast?.('Erreur lors de la soumission', 'error');
        btns.forEach(b => { b.disabled = false; b.textContent = 'Soumettre le quiz'; });
      }
    }

    function showResult() {
      document.getElementById('quiz-wrap')!.style.display = 'none';
      document.getElementById('result-screen')!.style.display = 'block';
      window.scrollTo({ top: 0 });

      const passed = result.passed;
      const pct = result.maxScore > 0 ? Math.round(result.totalScore / result.maxScore * 100) : 0;

      const hero = document.getElementById('result-hero')!;
      hero.classList.toggle('fail', !passed);

      const circle = document.getElementById('score-circle')!;
      circle.classList.toggle('fail', !passed);
      document.getElementById('score-num')!.textContent = pct + '%';
      document.getElementById('score-den')!.textContent = `${result.totalScore}/${result.maxScore}`;

      document.getElementById('result-title')!.textContent = passed ? 'Quiz réussi !' : 'Quiz échoué';

      let subtitle = '';
      if (passed) {
        subtitle = `Félicitations — ${result.totalScore} pts sur ${result.maxScore}.`;
      } else if (quiz.quizConfig?.passingScore) {
        subtitle = `Score insuffisant (${pct}% < ${quiz.quizConfig.passingScore}%). Réessayez !`;
      } else {
        subtitle = `Score : ${result.totalScore}/${result.maxScore}`;
      }
      document.getElementById('result-subtitle')!.textContent = subtitle;

      const badges = document.getElementById('result-badges')!;
      badges.innerHTML = `
        <span class="badge ${passed ? 'badge-green' : 'badge-red'}">${passed ? 'Réussi' : 'Échoué'}</span>
        <span class="badge badge-blue">${result.totalScore}/${result.maxScore} pts</span>
      `;

      // Actions
      const actionsDiv = document.getElementById('result-actions')!;
      const nextMod = allModules.find((m: any) => m.index > moduleIndex && !m.locked);
      let actionsHtml = '';
      if (passed && nextMod) {
        const href = nextMod.type === 'quiz' ? `/courses/${slug}/quiz/${nextMod.index}` : `/courses/${slug}/lessons/${nextMod.index}`;
        actionsHtml += `<a href="${href}" class="btn btn-primary">Module suivant ▸</a>`;
      }
      if (!passed) {
        actionsHtml += `<button class="btn btn-primary" id="retry-btn">Recommencer</button>`;
      }
      actionsHtml += `<a href="/courses/${slug}" class="btn btn-secondary">Retour au cours</a>`;
      actionsDiv.innerHTML = actionsHtml;

      document.getElementById('retry-btn')?.addEventListener('click', () => {
        submitted = false; result = null;
        for (const q of questions) {
          if (q.type === 'single') answers[q.id] = '';
          else if (q.type === 'multiple') answers[q.id] = [];
          else if (q.type === 'boolean') answers[q.id] = null;
          else if (q.type === 'order') answers[q.id] = (q.items || []).map((i: any) => i.id);
        }
        document.getElementById('result-screen')!.style.display = 'none';
        document.getElementById('quiz-wrap')!.style.display = 'block';
        renderAllQuestions();
        updatePalette();
        window.scrollTo({ top: 0 });
      });

      // Per-question review
      const reviewDiv = document.getElementById('question-review')!;
      if (result.questionResults?.length > 0) {
        reviewDiv.innerHTML = `<h3 class="quiz-review-heading">Correction</h3>` + result.questionResults.map((qr: any, i: number) => {
          const q = questions.find((q: any) => q.id === qr.questionId);
          return `
            <div class="review-item ${qr.isCorrect ? 'correct' : 'wrong'} mb-2">
              <div class="review-item-inner">
                <span class="review-status-icon ${qr.isCorrect ? 'correct' : 'wrong'}">${qr.isCorrect ? '✓' : '✗'}</span>
                <div class="review-item-body">
                  <p class="review-q-text">${i + 1}. ${q?.question || ''}</p>
                  <p class="review-q-score">${qr.pointsEarned}/${qr.pointsMax} pt${qr.pointsMax > 1 ? 's' : ''}</p>
                  ${qr.feedback ? `<p class="review-q-feedback">${qr.feedback}</p>` : ''}
                </div>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    (window as any).moveOrder = (qId: string, idx: number, dir: number) => {
      const arr = [...answers[qId]];
      const newIdx = idx + dir;
      if (newIdx < 0 || newIdx >= arr.length) return;
      [arr[idx], arr[newIdx]] = [arr[newIdx], arr[idx]];
      answers[qId] = arr;
      const card = document.getElementById(`q-card-${qId}`);
      if (card) {
        const q = questions.find(q => q.id === qId)!;
        const existing = card.querySelector(`#order-${qId}`);
        if (existing) existing.outerHTML = renderQuestionOptions(q);
      }
      bindOrderDrag(qId);
      updatePalette();
    };

    function reorderById(qId: string, fromId: string, toId: string) {
      const arr = [...answers[qId]];
      const fromIdx = arr.indexOf(fromId);
      const toIdx = arr.indexOf(toId);
      if (fromIdx < 0 || toIdx < 0 || fromIdx === toIdx) return;
      arr.splice(fromIdx, 1);
      arr.splice(toIdx, 0, fromId);
      answers[qId] = arr;
      const q = questions.find(q => q.id === qId)!;
      const existing = document.getElementById(`order-${qId}`);
      if (existing) existing.outerHTML = renderQuestionOptions(q);
      bindOrderDrag(qId);
      updatePalette();
    }

    function bindOrderDrag(qId: string) {
      const container = document.getElementById(`order-${qId}`);
      if (!container) return;

      let dragSrcId: string | null = null;

      container.querySelectorAll<HTMLElement>('.order-item').forEach(item => {
        // ── HTML5 DnD (mouse / trackpad) ──
        item.addEventListener('dragstart', e => {
          dragSrcId = item.dataset.id!;
          item.classList.add('dragging');
          if (e.dataTransfer) { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', dragSrcId); }
        });
        item.addEventListener('dragend', () => {
          item.classList.remove('dragging');
          container.querySelectorAll('.order-item').forEach(el => el.classList.remove('drag-over'));
          dragSrcId = null;
        });
        item.addEventListener('dragover', e => {
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
          if (item.dataset.id !== dragSrcId) {
            container.querySelectorAll('.order-item').forEach(el => el.classList.remove('drag-over'));
            item.classList.add('drag-over');
          }
        });
        item.addEventListener('dragleave', e => {
          if (!item.contains(e.relatedTarget as Node)) item.classList.remove('drag-over');
        });
        item.addEventListener('drop', e => {
          e.preventDefault();
          const targetId = item.dataset.id!;
          if (dragSrcId && dragSrcId !== targetId) reorderById(qId, dragSrcId, targetId);
        });
      });

      // ── Touch drag ──
      let touchItem: HTMLElement | null = null;
      let ghost: HTMLElement | null = null;
      let origTop = 0, origLeft = 0, touchStartX = 0, touchStartY = 0;

      container.querySelectorAll<HTMLElement>('.order-item').forEach(item => {
        item.addEventListener('touchstart', e => {
          if (e.touches.length !== 1) return;
          touchItem = item;
          const t = e.touches[0];
          touchStartX = t.clientX; touchStartY = t.clientY;
          const rect = item.getBoundingClientRect();
          origTop = rect.top; origLeft = rect.left;

          ghost = item.cloneNode(true) as HTMLElement;
          ghost.style.cssText = `position:fixed;z-index:9999;pointer-events:none;width:${rect.width}px;left:${origLeft}px;top:${origTop}px;opacity:.88;transform:rotate(1.5deg) scale(1.02);box-shadow:0 8px 28px rgba(0,0,0,.22);transition:none`;
          document.body.appendChild(ghost);
          item.classList.add('dragging');
        }, { passive: true });

        item.addEventListener('touchmove', e => {
          if (!touchItem || !ghost || e.touches.length !== 1) return;
          const t = e.touches[0];
          ghost.style.top  = (origTop  + t.clientY - touchStartY) + 'px';
          ghost.style.left = (origLeft + t.clientX - touchStartX) + 'px';

          ghost.style.display = 'none';
          const el = document.elementFromPoint(t.clientX, t.clientY);
          ghost.style.display = '';
          const hovered = el?.closest<HTMLElement>(`#order-${qId} .order-item`);
          container.querySelectorAll('.order-item').forEach(i => i.classList.remove('drag-over'));
          if (hovered && hovered !== touchItem) hovered.classList.add('drag-over');
        }, { passive: true });

        item.addEventListener('touchend', e => {
          if (!touchItem) return;
          ghost?.remove(); ghost = null;
          touchItem.classList.remove('dragging');
          container.querySelectorAll('.order-item').forEach(i => i.classList.remove('drag-over'));

          const t = e.changedTouches[0];
          const el = document.elementFromPoint(t.clientX, t.clientY);
          const hovered = el?.closest<HTMLElement>(`#order-${qId} .order-item`);
          if (hovered && hovered !== touchItem) {
            reorderById(qId, touchItem.dataset.id!, hovered.dataset.id!);
          }
          touchItem = null;
        });
      });
    }

    init();

    // Prevent copy-paste on quiz content to deter casual cheating.
    // Free-text inputs are intentionally excluded so typing is not affected.
    const quizRoot = document.getElementById('quiz-wrap')!;
    const resultRoot = document.getElementById('result-screen')!;
    for (const root of [quizRoot, resultRoot]) {
      root.addEventListener('copy', (e) => { e.preventDefault(); });
      root.addEventListener('cut',  (e) => { e.preventDefault(); });
      root.addEventListener('contextmenu', (e) => {
        if (!(e.target as HTMLElement).closest('input, textarea')) e.preventDefault();
      });
    }
  </script>
</App>
