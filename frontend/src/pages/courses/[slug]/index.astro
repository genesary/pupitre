---
import App from '../../../layouts/App.astro';
---
<App title="Cours" activePage="catalogue">

  <div class="course-outer">
  <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

  <div id="not-found" class="not-found-state" style="display:none">
    <div class="not-found-icon">😕</div>
    <h2>Cours introuvable</h2>
    <a href="/courses" class="btn btn-primary mt-4 inline-flex">Retour au catalogue</a>
  </div>

  <div id="course-content" class="course-page" style="display:none">
    <!-- Left sticky sidebar -->
    <aside class="course-sidebar">
      <div class="course-thumb" id="thumb-area"></div>
      <h1 id="course-title" class="course-title-head"></h1>
      <div id="course-tags" class="course-tags"></div>
      <p id="course-desc" class="text-soft text-sm course-desc-text"></p>
      <div id="course-badge-area"></div>
      <div id="enroll-area"></div>
      <div id="course-meta" class="stack course-meta-divider"></div>
    </aside>

    <!-- Right: module list -->
    <div class="course-main">
      <div class="course-main-header">
        <h2 class="text-[1rem] font-bold">Contenu du cours</h2>
        <span id="module-count" class="text-soft text-sm"></span>
      </div>
      <div id="modules-list"></div>
      <div id="modules-empty" class="modules-empty" style="display:none">
        <div class="text-[2.5rem] mb-3">📭</div>
        <p>Inscrivez-vous pour accéder aux modules.</p>
      </div>
      <div id="prereq-blocked" class="prereq-blocked" style="display:none">
        <div class="text-[2rem] mb-2.5">🔒</div>
        <p class="font-semibold mb-1">Prérequis non satisfaits</p>
        <p class="text-soft text-sm">Terminez les cours prérequis pour accéder à ce contenu.</p>
      </div>

      <!-- In-person sessions -->
      <div id="sessions-section" class="mt-8" style="display:none">
        <div class="sessions-section-header">
          <span class="text-[1.2rem]">📍</span>
          <h2 class="text-[1rem] font-bold">Sessions en présentiel</h2>
        </div>
        <div id="sessions-list"></div>
      </div>

    </div>
  </div>
  </div>

  <script>
    const slug = window.location.pathname.split('/').filter(Boolean)[1];
    const token = localStorage.getItem('token');

    function defaultThumbIcon(course: any): string {
      const tags = [course.category || '', ...(course.skills || [])].join(' ').toLowerCase();
      if (/pentest|hack|exploit|cyber|vuln|ctf/.test(tags))      return '🔐';
      if (/security|sécurité|secure/.test(tags))                  return '🛡️';
      if (/linux|unix|bash|shell/.test(tags))                     return '🐧';
      if (/git|gitlab|github|ci.?cd|devops|pipeline/.test(tags)) return '⚙️';
      if (/docker|container|podman/.test(tags))                   return '🐋';
      if (/kubernetes|k8s|helm/.test(tags))                       return '☸️';
      if (/python/.test(tags))                                    return '🐍';
      if (/network|réseau|tcp|ip|wifi/.test(tags))               return '🌐';
      if (/cloud|aws|azure|gcp/.test(tags))                       return '☁️';
      if (/database|sql|postgres|mysql/.test(tags))               return '🗄️';
      if (/web|http|html|css|frontend/.test(tags))                return '🌍';
      if (/javascript|typescript|node/.test(tags))                return '📦';
      if (/go|golang/.test(tags))                                  return '🦫';
      return '📖';
    }

    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        const error = new Error((err as any).error || `HTTP ${res.status}`) as any;
        error.status = res.status;
        throw error;
      }
      return res.json();
    }

    function moduleHref(m: any) {
      if (m.locked) return null;
      if (m.type === 'quiz') return `/courses/${slug}/quiz/${m.index}`;
      if (m.type === 'lab') return `/courses/${slug}/lessons/${m.index}`;
      return `/courses/${slug}/lessons/${m.index}`;
    }

    function moduleIcon(m: any): string | null {
      if (m.locked) return '🔒';
      if (m.type === 'video') return '🎬';
      if (m.type === 'image') return '🖼️';
      if (m.type === 'quiz') return '🧩';
      if (m.type === 'lab') return '🧪';
      return null;
    }

    function moduleStatusBadges(m: any, inlineQuiz?: any): string {
      const parts: string[] = [];
      const typeLabel: Record<string, string> = { quiz: 'Quiz', video: 'Vidéo', image: 'Image', lab: 'Lab', lesson: 'Lecture' };
      const typeStr = typeLabel[m.type];
      if (typeStr) parts.push(`<span class="badge badge-gray text-[.7rem]">${typeStr}</span>`);
      if (m.locked) {
        parts.push(`<span class="badge badge-gray text-[.7rem]">Verrouillé</span>`);
      } else if (m.type === 'quiz') {
        if (m.passed) parts.push(`<span class="badge badge-green text-[.7rem]">✓ ${m.bestScore}/${m.maxScore} pts</span>`);
        else if (m.attempts > 0) parts.push(`<span class="badge badge-orange text-[.7rem]">${m.attempts} tentative${m.attempts > 1 ? 's' : ''}</span>`);
        else parts.push(`<span class="badge badge-orange text-[.7rem]">★ quiz</span>`);
      } else {
        if (m.viewed) parts.push(`<span class="badge badge-green text-[.7rem]">✓ Vu</span>`);
      }
      // The quiz embedded at the end of this lesson has no row of its own,
      // so its state is reported here.
      if (inlineQuiz && !m.locked) {
        parts.push(inlineQuiz.passed
          ? `<span class="badge badge-green text-[.7rem]">✓ Quiz</span>`
          : `<span class="badge badge-orange text-[.7rem]">🧩 Quiz à valider</span>`);
      }
      return parts.join('');
    }

    function moduleSkillBadges(m: any): string {
      return (m.skills ?? []).map((s: string) =>
        `<span class="badge badge-purple text-[.65rem] cursor-pointer" onclick="event.preventDefault();event.stopPropagation();window.location.href='/skills/${s}'">🎯 ${s}</span>`
      ).join('');
    }

    function renderModules(modules: any[], inlineQuizByHost: Map<number, any>) {
      return modules.map(m => {
        const href = moduleHref(m);
        const tag = href ? 'a' : 'div';
        const hrefAttr = href ? `href="${href}"` : '';
        const icon = moduleIcon(m);
        const iconCls = m.locked ? '' : m.type === 'quiz' ? ' quiz' : (m.viewed || m.passed) ? ' done' : m.type === 'lab' ? ' lab' : '';
        const skillBadges = moduleSkillBadges(m);
        return `
          <${tag} ${hrefAttr} class="mod-row${m.locked ? ' locked' : ''}">
            ${icon ? `<div class="mod-icon${iconCls}">${icon}</div>` : ''}
            <div class="mod-name flex-1">${m.name}${skillBadges ? `<span class="mod-skill-badges">${skillBadges}</span>` : ''}</div>
            <div class="mod-badges">${moduleStatusBadges(m, inlineQuizByHost.get(m.index))}</div>
            ${href ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ink-soft)" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>` : ''}
          </${tag}>
        `;
      }).join('');
    }

    async function init() {
      try {
        const course = await apiFetch(`/courses/${slug}`, token ? { token } : {}) as any;

        document.title = `${course.title} — pupitre`;
        document.getElementById('course-title')!.textContent = course.title;
        document.getElementById('course-desc')!.textContent = course.description || '';

        // Thumbnail
        const thumbArea = document.getElementById('thumb-area')!;
        if (course.thumbnail) {
          thumbArea.innerHTML = `<img src="${course.thumbnail}" alt="${course.title}" />`;
        } else {
          thumbArea.textContent = defaultThumbIcon(course);
        }

        // Tags
        const tagsEl = document.getElementById('course-tags')!;
        const tagParts: string[] = [];
        if (course.difficulty) {
          const map: Record<string, string> = { beginner: 'badge-green', intermediate: 'badge-orange', advanced: 'badge-red' };
          const labels: Record<string, string> = { beginner: 'Débutant', intermediate: 'Intermédiaire', advanced: 'Avancé' };
          tagParts.push(`<span class="badge ${map[course.difficulty] || 'badge-blue'}">${labels[course.difficulty] || course.difficulty}</span>`);
        }
        if (course.category) tagParts.push(`<span class="badge badge-blue">${course.category}</span>`);
        (course.skills ?? []).forEach((s: string) => tagParts.push(`<a href="/skills/${s}" class="badge badge-purple text-[.75rem] no-underline">🎯 ${s}</a>`));
        tagsEl.innerHTML = tagParts.join('');

        document.getElementById('course-meta')!.style.display = 'none';

        // Enrollment check + badges (parallel when logged in)
        let enrolled = false;
        let modules: any[] = [];
        let prereqBlocked = false;
        let earnedSlugs = new Set<string>();

        if (token) {
          const [myCoursesRes, myBadgesRes] = await Promise.allSettled([
            apiFetch('/my/courses', { token: token! }),
            apiFetch('/my/badges', { token: token! }),
          ]);
          if (myCoursesRes.status === 'fulfilled') {
            enrolled = ((myCoursesRes.value as any).courses || []).some((c: any) => c.slug === slug || c.id === slug);
          }
          if (myBadgesRes.status === 'fulfilled') {
            ((myBadgesRes.value as any).badges || []).forEach((b: any) => earnedSlugs.add(b.courseSlug));
          }

          if (enrolled) {
            try {
              const modRes = await apiFetch(`/courses/${slug}/modules`, { token: token! }) as any;
              modules = modRes.modules || [];
            } catch (e: any) {
              if (e.status === 403) prereqBlocked = true;
            }
          }
        }

        // Badge card
        if (course.badge) {
          const badgeArea = document.getElementById('course-badge-area')!;
          const earned = earnedSlugs.has(slug);
          const iconEl = document.createElement('a');
          iconEl.href = earned ? '/my-badges' : '#';
          iconEl.className = `course-badge-card ${earned ? 'course-badge-earned' : 'course-badge-locked'}`;
          const iconSpan = document.createElement('span');
          iconSpan.className = 'text-[1.6rem]';
          iconSpan.textContent = course.badge.icon || '🏅';
          const textDiv = document.createElement('div');
          const labelDiv = document.createElement('div');
          labelDiv.className = `course-badge-label ${earned ? 'course-badge-label-earned' : 'course-badge-label-locked'}`;
          labelDiv.textContent = earned ? '✓ Badge obtenu' : 'Badge à obtenir';
          const nameDiv = document.createElement('div');
          nameDiv.className = 'course-badge-name';
          nameDiv.textContent = course.badge.name || 'Badge';
          textDiv.appendChild(labelDiv);
          textDiv.appendChild(nameDiv);
          iconEl.appendChild(iconSpan);
          iconEl.appendChild(textDiv);
          badgeArea.appendChild(iconEl);
        }

        // Inline quizzes are embedded in the previous lesson, so they get no row
        // of their own — but they are still work to do, and progress counts them.
        const listModules = modules.filter((m: any) => !m.inline);
        const isDone = (m: any) => m.type === 'quiz' ? m.passed : m.viewed;

        // An inline quiz lives at the bottom of the lesson preceding it: that
        // lesson is both the page it is reached through and the row its state
        // is reported on.
        const hostOf = (m: any) => modules.filter((x: any) => x.index < m.index && !x.inline).at(-1);
        const inlineQuizByHost = new Map<number, any>();
        for (const quiz of modules.filter((m: any) => m.inline)) {
          const host = hostOf(quiz);
          if (host) inlineQuizByHost.set(host.index, quiz);
        }

        function moduleEntryHref(m: any): string | null {
          return moduleHref(m.inline ? (hostOf(m) ?? m) : m);
        }

        // Enroll area
        const enrollArea = document.getElementById('enroll-area')!;
        const completedCount = modules.filter(isDone).length;
        const totalCount = modules.length;
        const pct = totalCount > 0 ? Math.round(completedCount / totalCount * 100) : 0;

        if (!enrolled) {
          if (course.isPublic) {
            enrollArea.innerHTML = `<button class="btn btn-primary w-full" id="enroll-btn">S'inscrire au cours</button>`;
            document.getElementById('enroll-btn')!.addEventListener('click', async () => {
              if (!token) { window.location.href = `/login?redirect=/courses/${slug}`; return; }
              try {
                await apiFetch(`/enrollments/${slug}`, { method: 'POST', body: {}, token: token! });
              } catch { /* ok */ }
              window.location.reload();
            });
          } else {
            enrollArea.innerHTML = `
              <div class="course-restricted">
                🔒 Accès restreint — contactez un administrateur
              </div>
            `;
          }
        } else if (totalCount > 0) {
          // Find first incomplete module for CTA
          const nextMod = modules.find((m: any) => !isDone(m) && !m.locked);
          const ctaHref = (nextMod ? moduleEntryHref(nextMod) : null)
            ?? (listModules[0] ? moduleHref(listModules[0]) : null)
            ?? '#';

          const xpEarned = Math.round(pct / 100 * 200);
          enrollArea.innerHTML = `
            <div class="course-enroll-progress">
              <div class="course-enroll-progress-header">
                <span>${completedCount}/${totalCount} complétés</span>
                <span class="course-enroll-pct">${pct}%</span>
              </div>
              <div class="progress-bar"><div class="progress-bar-fill" style="width:${pct}%"></div></div>
            </div>
            <a href="/my-xp" class="course-xp-card no-underline cursor-pointer">
              <div class="course-xp-row ${pct < 100 ? 'mb-[5px]' : ''}">
                <span>⚡ XP de ce cours</span>
                <span class="course-xp-amount">${pct === 100 ? '+200 XP ✓' : `${xpEarned} / 200 XP`}</span>
              </div>
              ${pct < 100 ? `<div class="course-xp-bar"><div class="course-xp-bar-fill" style="width:${pct}%"></div></div>` : ''}
            </a>
            <a href="${ctaHref}" class="btn btn-primary w-full inline-flex">
              ${pct === 0 ? 'Commencer le cours ▸' : pct === 100 ? 'Revoir le cours ▸' : 'Continuer le cours ▸'}
            </a>
          `;
        }

        // Module count
        document.getElementById('module-count')!.textContent = listModules.length > 0 ? `${listModules.length} module${listModules.length !== 1 ? 's' : ''}` : '';

        // Render modules (inline quizzes excluded — they appear embedded in the previous lesson)
        if (prereqBlocked) {
          document.getElementById('prereq-blocked')!.style.display = 'block';
        } else if (enrolled && listModules.length > 0) {
          const list = document.getElementById('modules-list')!;
          list.innerHTML = renderModules(listModules, inlineQuizByHost);
          // Opening a lab counts as completing it (link opens in a new tab,
          // so we can record progress without blocking navigation)
          list.querySelectorAll('a[data-lab-slug]').forEach(el => {
            el.addEventListener('click', () => {
              const labSlug = (el as HTMLElement).dataset.labSlug;
              if (token && labSlug) {
                apiFetch(`/courses/${slug}/lessons/${labSlug}/complete`, { method: 'POST', body: {}, token: token! }).catch(() => {});
              }
            });
          });
        } else if (enrolled) {
          document.getElementById('modules-empty')!.textContent = 'Aucun contenu disponible pour le moment.';
          document.getElementById('modules-empty')!.style.display = 'block';
        } else {
          document.getElementById('modules-empty')!.style.display = 'block';
        }

        // Sessions présentiel
        if (course.inPerson && course.sessions?.length > 0) {
          const sessionsSection = document.getElementById('sessions-section')!;
          sessionsSection.style.display = 'block';

          let bookedIds = new Set<string>();
          if (token) {
            try {
              const bookRes = await apiFetch('/my/session-bookings', { token: token! }) as any;
              (bookRes.bookings || []).forEach((b: any) => {
                if (b.courseSlug === slug) bookedIds.add(b.sessionId);
              });
            } catch { /* non connecté */ }
          }

          const now = new Date();
          const sessionsList = document.getElementById('sessions-list')!;
          sessionsList.innerHTML = course.sessions.map((s: any) => {
            const date = new Date(s.date);
            const isPast = date < now;
            const isBooked = bookedIds.has(s.id);
            const dateStr = date.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            const timeStr = date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
            const btnId = `btn-session-${s.id}`;
            return `
              <div class="session-card ${isBooked ? 'session-card-booked' : 'session-card-default'}${isPast ? ' opacity-50' : ''}">
                <div class="session-card-inner">
                  <div>
                    <div class="session-title">${s.title}</div>
                    <div class="session-meta-text">📅 ${dateStr} à ${timeStr}</div>
                    ${s.location ? `<div class="session-meta-text mt-0.5">📍 ${s.location}</div>` : ''}
                    ${s.capacity > 0 ? `<div class="session-capacity">🪑 ${s.capacity} places</div>` : ''}
                  </div>
                  ${!isPast && token ? `
                    <button id="${btnId}" data-sid="${s.id}" data-booked="${isBooked}"
                      class="btn ${isBooked ? 'btn-secondary' : 'btn-primary'} whitespace-nowrap shrink-0">
                      ${isBooked ? '✓ Réservé — Annuler' : 'Réserver'}
                    </button>
                  ` : ''}
                </div>
              </div>
            `;
          }).join('');

          sessionsList.querySelectorAll('button[data-sid]').forEach(btn => {
            btn.addEventListener('click', async () => {
              const sid = (btn as HTMLElement).dataset.sid!;
              const booked = (btn as HTMLElement).dataset.booked === 'true';
              try {
                if (booked) {
                  await apiFetch(`/session-bookings/${slug}/${sid}`, { method: 'DELETE', token: token! });
                } else {
                  await apiFetch(`/session-bookings/${slug}/${sid}`, { method: 'POST', token: token! });
                }
                window.location.reload();
              } catch { alert('Une erreur est survenue, veuillez réessayer.'); }
            });
          });
        }

        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('course-content')!.style.display = 'grid'; // grid inside course-outer
      } catch {
        document.getElementById('loading')!.style.display = 'none';
        document.getElementById('not-found')!.style.display = 'block';
      }
    }

    init();
  </script>
</App>
