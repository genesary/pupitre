---
import App from '../layouts/App.astro';
---
<App title="Mon profil">
  <div class="page-content">
    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>
    <div id="profile-content" style="display:none">
      <div class="profile-layout">
        <!-- Left sidebar nav -->
        <aside class="sidebar">
          <div class="card-sm mb-4 text-center p-5">
            <div id="avatar-wrapper" class="profile-avatar-wrapper" title="Changer la photo de profil">
              <div id="avatar-area" class="w-20 h-20"></div>
              <div id="avatar-edit-overlay" class="profile-avatar-overlay">✏️<br>Modifier</div>
            </div>
            <!-- Emoji picker for profile photo -->
            <div id="avatar-picker" class="mb-3" style="display:none">
              <div class="text-[.72rem] text-ink-soft mb-1.5">Photo de profil</div>
              <div id="avatar-picker-grid" class="flex flex-wrap gap-1.5 justify-center"></div>
            </div>
            <div id="profile-name" class="font-bold mb-0.5"></div>
            <div id="profile-email" class="text-[.8rem] text-ink-soft"></div>
            <div id="profile-role" class="mt-2"></div>
          </div>
          <nav class="sidebar-nav">
            <a class="sidebar-link active" href="#compte" data-section="compte">👤 Compte</a>
            <a class="sidebar-link" href="#securite" data-section="securite">🔒 Sécurité</a>
          </nav>
        </aside>

        <!-- Right: sections -->
        <div class="stack-lg">
          <!-- Compte section -->
          <div id="section-compte" class="card">
            <div class="profile-section-header">
              <h2 class="text-[1.1rem]">Mon compte</h2>
              <button class="btn btn-secondary btn-sm" id="edit-btn">Modifier</button>
            </div>

            <!-- View mode -->
            <div id="view-mode">
              <div class="stack gap-[14px]">
                <div class="profile-field-row">
                  <span class="text-soft text-sm pt-0.5">Nom d'utilisateur</span>
                  <span id="view-username" class="font-medium text-[.9rem]"></span>
                </div>
                <div class="profile-field-row">
                  <span class="text-soft text-sm pt-0.5">Email</span>
                  <span id="view-email" class="text-[.9rem]"></span>
                </div>
                <div class="profile-field-row">
                  <span class="text-soft text-sm pt-0.5">Bio</span>
                  <span id="view-bio" class="text-[.9rem] text-ink-soft"></span>
                </div>
                <!-- Shown only for non-SSO users with an avatar URL set -->
                <div id="view-avatar-row" class="profile-field-row" style="display:none">
                  <span class="text-soft text-sm pt-0.5">URL avatar</span>
                  <span id="view-avatar" class="text-[.85rem] text-ink-soft overflow-hidden text-ellipsis whitespace-nowrap"></span>
                </div>
              </div>
            </div>

            <!-- Edit mode -->
            <form id="edit-mode" class="stack gap-[14px]" style="display:none">
              <div id="avatar-field" class="form-group" style="display:none">
                <label class="label" for="edit-avatar">URL de l'avatar</label>
                <input class="input" type="url" id="edit-avatar" placeholder="https://example.com/avatar.png" />
              </div>
              <div class="form-group">
                <label class="label" for="edit-bio">Bio</label>
                <textarea class="input" id="edit-bio" rows="3" placeholder="Dites-nous quelque chose sur vous…"></textarea>
              </div>
              <div id="sso-avatar-notice" class="sso-notice" style="display:none"></div>
              <div class="flex gap-2.5">
                <button type="submit" class="btn btn-primary" id="save-btn">Enregistrer</button>
                <button type="button" class="btn btn-secondary" id="cancel-btn">Annuler</button>
              </div>
              <p id="save-error" class="text-bad text-[.85rem]" style="display:none"></p>
            </form>
          </div>

          <!-- Sécurité section -->
          <div id="section-securite" class="card" style="display:none">
            <h2 class="text-[1.1rem] mb-5">Sécurité</h2>
            <div id="security-content"></div>
          </div>


        </div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/profile'; }

    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error((err as any).error || `HTTP ${res.status}`); }
      return res.json();
    }

    let user: any = null;

    const providerLabels: Record<string, string> = { github: 'GitHub', gitlab: 'GitLab', google: 'Google', oidc: 'SSO / OIDC', ldap: 'LDAP / Active Directory' };

    async function init() {
      if (!token) return;
      try {
        [user] = await Promise.all([
          apiFetch('/auth/me', { token: token! }),
          loadEarnedIcons(),
        ]);
        render();
        buildPicker();
      } catch {
        (window as any).showToast?.('Erreur lors du chargement du profil', 'error');
      }
    }

    function render() {
      document.getElementById('loading')!.style.display = 'none';
      document.getElementById('profile-content')!.style.display = 'block';

      const isSso = user.authProvider && user.authProvider !== 'local' && user.authProvider !== '';
      const initial = (user.username || '?')[0].toUpperCase();

      // Sidebar mini-profile
      const avatarArea = document.getElementById('avatar-area')!;
      const avatarIsUrl = user.avatarUrl && (
        user.avatarUrl.startsWith('http://') ||
        user.avatarUrl.startsWith('https://') ||
        user.avatarUrl.startsWith('/uploads/avatars/')
      );
      if (avatarIsUrl) {
        avatarArea.innerHTML = `<img src="${user.avatarUrl}" alt="${user.username}" class="avatar-circle" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><div class="avatar-initial" style="display:none">${initial}</div>`;
      } else if (user.avatarUrl) {
        const emojiDiv = document.createElement('div');
        emojiDiv.className = 'avatar-initial';
        emojiDiv.style.fontSize = '2rem';
        emojiDiv.textContent = user.avatarUrl;
        avatarArea.innerHTML = '';
        avatarArea.appendChild(emojiDiv);
      } else {
        avatarArea.innerHTML = `<div class="avatar-initial">${initial}</div>`;
      }
      document.getElementById('profile-name')!.textContent = user.username;
      document.getElementById('profile-email')!.textContent = user.email;

      const roleDiv = document.getElementById('profile-role')!;
      roleDiv.innerHTML = '';
      if (user.role === 'admin') roleDiv.innerHTML += '<span class="badge badge-red">Admin</span> ';
      if (isSso) roleDiv.innerHTML += `<span class="badge badge-blue">${providerLabels[user.authProvider] || user.authProvider}</span>`;

      // View mode
      document.getElementById('view-username')!.textContent = user.username;
      document.getElementById('view-email')!.textContent = user.email;
      document.getElementById('view-bio')!.textContent = user.bio || '—';

      if (!isSso && user.avatarUrl && !user.avatarUrl.startsWith('/uploads/avatars/')) {
        const row = document.getElementById('view-avatar-row')!;
        row.style.display = 'grid';
        document.getElementById('view-avatar')!.textContent = user.avatarUrl;
      }

      // Edit mode setup
      if (!isSso) {
        document.getElementById('avatar-field')!.style.display = 'block';
        const currentAvatarForInput = (user.avatarUrl && (user.avatarUrl.startsWith('http://') || user.avatarUrl.startsWith('https://'))) ? user.avatarUrl : '';
        (document.getElementById('edit-avatar') as HTMLInputElement).value = currentAvatarForInput;
      } else {
        const notice = document.getElementById('sso-avatar-notice')!;
        notice.style.display = 'block';
        notice.textContent = `Votre avatar est synchronisé automatiquement depuis ${providerLabels[user.authProvider] || user.authProvider} à chaque connexion.`;
      }
      (document.getElementById('edit-bio') as HTMLTextAreaElement).value = user.bio || '';

      // Security section
      const secContent = document.getElementById('security-content')!;
      if (isSso) {
        secContent.innerHTML = `<p class="text-soft text-sm">Votre compte est géré par <strong>${providerLabels[user.authProvider] || user.authProvider}</strong>. La gestion du mot de passe est assurée par votre fournisseur d'identité.</p>`;
      } else {
        secContent.innerHTML = `
          <div id="pw-view">
            <p class="text-soft text-sm mb-3">Utilisez un mot de passe fort d'au moins 8 caractères.</p>
            <button class="btn btn-secondary btn-sm" id="change-pw-btn">Changer le mot de passe</button>
          </div>
          <form id="pw-form" class="stack gap-3" style="display:none">
            <div class="form-group">
              <label class="label" for="old-pw">Mot de passe actuel</label>
              <input class="input" type="password" id="old-pw" autocomplete="current-password" />
            </div>
            <div class="form-group">
              <label class="label" for="new-pw">Nouveau mot de passe</label>
              <input class="input" type="password" id="new-pw" autocomplete="new-password" />
            </div>
            <div class="form-group">
              <label class="label" for="new-pw2">Confirmer le mot de passe</label>
              <input class="input" type="password" id="new-pw2" autocomplete="new-password" />
            </div>
            <div class="flex gap-2.5">
              <button type="submit" class="btn btn-primary" id="pw-save-btn">Mettre à jour</button>
              <button type="button" class="btn btn-secondary" id="pw-cancel-btn">Annuler</button>
            </div>
            <p id="pw-error" class="text-bad text-[.85rem]" style="display:none"></p>
          </form>
        `;

        document.getElementById('change-pw-btn')!.addEventListener('click', () => {
          document.getElementById('pw-view')!.style.display = 'none';
          document.getElementById('pw-form')!.style.display = 'block';
        });
        document.getElementById('pw-cancel-btn')!.addEventListener('click', () => {
          document.getElementById('pw-view')!.style.display = 'block';
          document.getElementById('pw-form')!.style.display = 'none';
        });
        document.getElementById('pw-form')!.addEventListener('submit', async (e) => {
          e.preventDefault();
          const old = (document.getElementById('old-pw') as HTMLInputElement).value;
          const nw = (document.getElementById('new-pw') as HTMLInputElement).value;
          const nw2 = (document.getElementById('new-pw2') as HTMLInputElement).value;
          const errEl = document.getElementById('pw-error')!;
          errEl.style.display = 'none';
          if (nw !== nw2) { errEl.textContent = 'Les mots de passe ne correspondent pas'; errEl.style.display = 'block'; return; }
          if (nw.length < 8) { errEl.textContent = 'Minimum 8 caractères'; errEl.style.display = 'block'; return; }
          const btn = document.getElementById('pw-save-btn') as HTMLButtonElement;
          btn.disabled = true; btn.textContent = 'Enregistrement…';
          try {
            await apiFetch('/auth/password', { method: 'PUT', body: { oldPassword: old, newPassword: nw }, token: token! });
            (window as any).showToast?.('Mot de passe mis à jour', 'success');
            document.getElementById('pw-view')!.style.display = 'block';
            document.getElementById('pw-form')!.style.display = 'none';
            (document.getElementById('old-pw') as HTMLInputElement).value = '';
            (document.getElementById('new-pw') as HTMLInputElement).value = '';
            (document.getElementById('new-pw2') as HTMLInputElement).value = '';
          } catch (err: any) {
            errEl.textContent = err.message || 'Erreur lors du changement';
            errEl.style.display = 'block';
          } finally {
            btn.disabled = false; btn.textContent = 'Mettre à jour';
          }
        });
      }

    }

    // Avatar emoji picker
    let earnedIcons: string[] = [];

    async function loadEarnedIcons() {
      try {
        const data = await apiFetch('/my/badges', { token: token! }) as any;
        earnedIcons = (data.badges || []).map((b: any) => b.icon || '🏅').filter(Boolean);
      } catch { /* ignore */ }
    }

    function buildPicker() {
      const grid = document.getElementById('avatar-picker-grid')!;
      if (earnedIcons.length === 0) {
        document.getElementById('avatar-picker')!.style.display = 'none';
        return;
      }
      grid.innerHTML = earnedIcons.map(icon => `
        <button class="avatar-pick-btn" data-icon="${icon}" title="${icon}">${icon}</button>
      `).join('');
      grid.querySelectorAll<HTMLElement>('.avatar-pick-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const icon = btn.dataset.icon!;
          try {
            const updated = await apiFetch('/auth/profile', { method: 'PUT', body: { avatarUrl: icon }, token: token! }) as any;
            user = updated;
            localStorage.setItem('user', JSON.stringify(updated));
            document.getElementById('avatar-picker')!.style.display = 'none';
            render();
            (window as any).showToast?.('Photo de profil mise à jour', 'success');
          } catch {
            (window as any).showToast?.('Erreur lors de la mise à jour', 'error');
          }
        });
      });
    }

    const avatarWrapper = document.getElementById('avatar-wrapper')!;
    avatarWrapper.addEventListener('mouseenter', () => {
      document.getElementById('avatar-edit-overlay')!.style.display = 'flex';
    });
    avatarWrapper.addEventListener('mouseleave', () => {
      document.getElementById('avatar-edit-overlay')!.style.display = 'none';
    });
    avatarWrapper.addEventListener('click', () => {
      const picker = document.getElementById('avatar-picker')!;
      if (earnedIcons.length === 0) return;
      const isOpen = picker.style.display !== 'none';
      picker.style.display = isOpen ? 'none' : 'block';
    });

    // Edit profile events
    document.getElementById('edit-btn')!.addEventListener('click', () => {
      document.getElementById('view-mode')!.style.display = 'none';
      document.getElementById('edit-mode')!.style.display = 'block';
    });

    document.getElementById('cancel-btn')!.addEventListener('click', () => {
      document.getElementById('view-mode')!.style.display = 'block';
      document.getElementById('edit-mode')!.style.display = 'none';
    });

    document.getElementById('edit-mode')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = document.getElementById('save-error')!;
      errEl.style.display = 'none';
      const btn = document.getElementById('save-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Enregistrement…';

      const bio = (document.getElementById('edit-bio') as HTMLTextAreaElement).value;
      const avatarInput = document.getElementById('edit-avatar') as HTMLInputElement;
      const avatarVal = avatarInput?.value?.trim() ?? '';

      try {
        let updated: any;
        if (avatarVal.startsWith('http://') || avatarVal.startsWith('https://')) {
          // Server-side fetch + SSRF-safe re-encode; then save bio separately.
          await apiFetch('/auth/avatar/fetch', { method: 'POST', body: { url: avatarVal }, token: token! });
          updated = await apiFetch('/auth/profile', { method: 'PUT', body: { bio }, token: token! });
        } else {
          const body: Record<string, string> = { bio };
          if (avatarVal) body.avatarUrl = avatarVal;
          updated = await apiFetch('/auth/profile', { method: 'PUT', body, token: token! });
        }
        user = updated;
        localStorage.setItem('user', JSON.stringify(updated));
        document.getElementById('view-mode')!.style.display = 'block';
        document.getElementById('edit-mode')!.style.display = 'none';
        render();
        (window as any).showToast?.('Profil mis à jour', 'success');
      } catch (err: any) {
        errEl.textContent = err.message || 'Erreur lors de la sauvegarde';
        errEl.style.display = 'block';
      } finally {
        btn.disabled = false; btn.textContent = 'Enregistrer';
      }
    });

    // Sidebar tab switching
    function switchSection(name: string) {
      document.querySelectorAll<HTMLElement>('[id^="section-"]').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.sidebar-link').forEach(el => el.classList.remove('active'));
      const section = document.getElementById(`section-${name}`);
      if (section) section.style.display = 'block';
      const link = document.querySelector<HTMLElement>(`.sidebar-link[data-section="${name}"]`);
      if (link) link.classList.add('active');
    }

    document.querySelectorAll<HTMLElement>('.sidebar-link[data-section]').forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        switchSection(link.dataset.section!);
        history.replaceState(null, '', `#${link.dataset.section}`);
      });
    });

    if (!token) {
      window.location.href = '/login?redirect=/profile';
    } else {
      const hash = location.hash.replace('#', '');
      if (hash) switchSection(hash);
      init();
    }
  </script>
</App>
