---
import App from '../layouts/App.astro';
---
<App title="Mes parcours" activePage="paths">
  <div class="page-outer">
    <div class="page-inner">
    <h1 class="page-title mb-1.5">Mes parcours</h1>
    <p class="text-[.9rem] text-ink-soft mb-7" id="mp-sub"></p>
    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>
    <div id="mp-content" class="hidden">
      <div id="view-list">
        <div id="mp-list" class="flex flex-col gap-4"></div>
        <div id="mp-empty" class="hidden text-center py-20 px-6">
          <div class="text-[3rem] mb-3.5">🗺️</div>
          <h2 class="text-[1.15rem] mb-2">Aucun parcours en cours</h2>
          <p class="text-ink-soft text-[.88rem] mb-5">Vous n'êtes inscrit à aucun parcours. Contactez un administrateur pour être inscrit.</p>
          <a href="/courses" class="btn btn-primary">Voir le catalogue</a>
        </div>
      </div>
      <div id="view-detail" class="hidden">
        <button class="detail-back" id="btn-back">◂ Mes parcours</button>
        <div id="detail-content"></div>
      </div>
    </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/my-paths'; }

    const LEVELS: Record<string,{label:string;cls:string}> = {
      beginner:     { label: 'Niveau 1 · Débutant',      cls: 'level-1' },
      intermediate: { label: 'Niveau 2 · Intermédiaire', cls: 'level-2' },
      advanced:     { label: 'Niveau 3 · Avancé',        cls: 'level-3' },
    };
    function levelBadge(level: string): string {
      const l = LEVELS[level];
      if (!l) return '';
      return `<span class="level-badge ${l.cls}">${l.label}</span>`;
    }

    const SHORT: Record<string,string> = {
      'linux-intro':         'Linux',
      'docker-fundamentals': 'Docker',
      'kubernetes-basics':   'Kubernetes',
      'networking-basics':   'Réseaux',
      'cybersecurity-intro': 'Cybersécurité',
    };
    function sName(s: string) {
      return SHORT[s] ?? s.split('-').map((w:string)=>w[0].toUpperCase()+w.slice(1)).join(' ');
    }

    const PATH_ICONS: Record<string,string> = { 'devops-path':'⚙️','security-path':'🔐','devops':'⚙️','security':'🔐' };
    const PALETTE = [
      { bg:'#ffffff', iconBg:'#d1fae5', accent:'#059669' },
      { bg:'#ffffff', iconBg:'#ede9fe', accent:'#7c3aed' },
      { bg:'#ffffff', iconBg:'#dbeafe', accent:'#2563eb' },
      { bg:'#ffffff', iconBg:'#fce7f3', accent:'#db2777' },
      { bg:'#ffffff', iconBg:'#fef3c7', accent:'#d97706' },
    ];


    let allPaths: any[] = [];

    function renderList(): string {
      return allPaths.map((p:any, idx:number) => {
        const isSkillPath = p.kind === 'skill';
        const total = (p.courses?.length ?? 0);
        const done  = (p.courses??[]).filter((c:any)=>c.status==='completed').length;
        const pct   = total>0 ? Math.round(done/total*100) : 0;
        const allDone = pct===100;
        const sub = isSkillPath
          ? `${total} compétence${total>1?'s':''} · ${allDone?'✓ Acquises':done>0?`${done}/${total} acquises`:'À commencer'}`
          : `${done}/${total} cours · ${allDone?'✓ Terminé':pct>0?'En cours':'À commencer'}`;
        const colors = PALETTE[idx % PALETTE.length];
        return `<div class="path-list-card path-palette-${idx % 5}" data-slug="${p.slug}">
          <div class="path-list-banner">
            <div class="path-list-icon">${PATH_ICONS[p.slug]??'🗺️'}</div>
            <div class="path-list-body">
              <div class="path-list-title">${p.title||p.slug}</div>
              ${p.level ? levelBadge(p.level) : ''}
              <div class="path-list-sub">${sub}</div>
            </div>
            <span class="path-list-pct">${pct}%</span>
            <span class="path-list-chevron">›</span>
          </div>
          <div class="path-list-progress">
            <div class="path-list-progress-fill" style="width:${pct}%"></div>
          </div>
        </div>`;
      }).join('');
    }

    function wrapSVG(text: string, maxLen: number): string[] {
      if (text.length <= maxLen) return [text];
      const sp = text.lastIndexOf(' ', maxLen);
      return sp > 0 ? [text.slice(0,sp), text.slice(sp+1)] : [text.slice(0,maxLen), text.slice(maxLen)];
    }

    function buildRoad(pts: {x:number;y:number}[], cr: number): string {
      if (pts.length < 2) return '';
      let d = `M ${pts[0].x} ${pts[0].y}`;
      for (let i = 1; i < pts.length; i++) {
        const prev = pts[i-1], curr = pts[i], next = i < pts.length-1 ? pts[i+1] : null;
        const turns = next && !(
          (prev.x === curr.x && curr.x === next.x) ||
          (prev.y === curr.y && curr.y === next.y)
        );
        if (!turns) { d += ` L ${curr.x} ${curr.y}`; continue; }
        const dx1 = curr.x-prev.x, dy1 = curr.y-prev.y;
        const dx2 = next!.x-curr.x, dy2 = next!.y-curr.y;
        const l1 = Math.hypot(dx1,dy1), l2 = Math.hypot(dx2,dy2);
        const t = Math.min(cr/l1, 0.42), s = Math.min(cr/l2, 0.42);
        const ax = curr.x-dx1*t, ay = curr.y-dy1*t;
        const bx = curr.x+dx2*s, by = curr.y+dy2*s;
        d += ` L ${ax} ${ay} Q ${curr.x} ${curr.y} ${bx} ${by}`;
      }
      return d;
    }

    function renderDetail(p: any): string {
      const isSkillPath = p.kind === 'skill';
      const isDark = document.documentElement.classList.contains('dark');
      const TH: Record<string,{fill:string;text:string;roadFill:string;badge:string;badgeTxt:string;label:string}> = isDark ? {
        completed: { fill:'#0d2218', text:'#4ade80', roadFill:'#4ade80', badge:'#0d2218', badgeTxt:'#4ade80', label:'Terminé'    },
        available:  { fill:'#162336', text:'#60a5fa', roadFill:'#3b82f6', badge:'#162336', badgeTxt:'#60a5fa', label:'Disponible' },
        locked:     { fill:'#1a1d24', text:'#8b92a0', roadFill:'#252830', badge:'#1a1d24', badgeTxt:'#8b92a0', label:'Verrouillé' },
      } : {
        completed: { fill:'#bbf7d0', text:'#15803d', roadFill:'#4ade80', badge:'#dcfce7', badgeTxt:'#15803d', label:'Terminé'    },
        available:  { fill:'#bfdbfe', text:'#1d4ed8', roadFill:'#93c5fd', badge:'#dbeafe', badgeTxt:'#1d4ed8', label:'Disponible' },
        locked:     { fill:'#f1f5f9', text:'#94a3b8', roadFill:'#e2e8f0', badge:'#f1f5f9', badgeTxt:'#94a3b8', label:'Verrouillé' },
      };
      const circleFill = isDark ? '#1e2128' : 'white';
      const roadStroke = isDark ? '#252830' : '#e2e8f0';
      const nameFill   = isDark ? '#dde1ea' : '#334155';
      const courses: any[] = p.courses ?? [];
      const total = courses.length;
      const done  = courses.filter((c:any)=>c.status==='completed').length;
      const pct   = total>0 ? Math.round(done/total*100) : 0;
      const allDone = done===total && total>0;

      const CPR=5, NR=18, HG=200, VG=125, ROAD=6, CR=28, LABEL=38, PX=40, PY=45;
      const numRows = Math.ceil(total / CPR);
      const effectiveCols = Math.min(total, CPR);
      const VB_W = PX * 2 + HG * (effectiveCols - 1);
      const VB_H = PY + VG * Math.max(numRows - 1, 0) + NR + LABEL + 20;

      function nodePos(i: number): {x:number; y:number} {
        const row = Math.floor(i / CPR);
        const col = i % CPR;
        const xIdx = (row % 2 === 0) ? col : (CPR - 1 - col);
        return { x: PX + xIdx * HG, y: PY + row * VG };
      }

      const pts = courses.map((_:any, i:number) => nodePos(i));
      const grayD = buildRoad(pts, CR);
      const progEnd = Math.min(done < total ? done : done - 1, total - 1);
      const progPts = done > 0 || (done === 0 && total > 0 && courses[0]?.status === 'available')
        ? pts.slice(0, progEnd + 1)
        : [];
      const progD = buildRoad(progPts, CR);
      const progCol = allDone ? '#4ade80' : (isDark ? '#3b82f6' : '#93c5fd');

      let nodesSVG = '';
      courses.forEach((c: any, i: number) => {
        const { x, y } = pts[i];
        const th = TH[c.status] ?? TH.locked;
        const num = i + 1;
        const isLocked = c.status === 'locked';
        const pulse = c.status === 'available' ? `
          <circle cx="${x}" cy="${y}" r="${NR+5}" fill="none" stroke="${th.fill}" stroke-width="2.5" opacity="0">
            <animate attributeName="r" values="${NR+3};${NR+20}" dur="2s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.35;0" dur="2s" repeatCount="indefinite"/>
          </circle>` : '';
        const icon = c.status === 'completed' ? '✓' : String(num);
        const fontSize = c.status === 'completed' ? 14 : 12;
        const lines = wrapSVG(sName(c.slug), 16);
        const BW = 64, BH = 14;
        const LINE_H = 11;
        const NAME_ROWS = 2;
        const nameY0 = y + NR + 10;
        const nameEls = lines.map((ln: string, li: number) =>
          `<text x="${x}" y="${nameY0 + li*LINE_H}" text-anchor="middle" dominant-baseline="hanging"
            font-size="9" font-weight="500" fill="${nameFill}" font-family="system-ui,sans-serif">${ln}</text>`
        ).join('');
        const badgeY = nameY0 + NAME_ROWS * LINE_H + 3;
        const badgeEl = `
          <rect x="${x-BW/2}" y="${badgeY}" width="${BW}" height="${BH}" rx="${BH/2}" fill="${th.badge}"/>
          <text x="${x}" y="${badgeY+BH/2}" text-anchor="middle" dominant-baseline="middle"
            font-size="7" font-weight="600" fill="${th.badgeTxt}" font-family="system-ui,sans-serif">${th.label}</text>`;
        const lockBadge = isLocked ? `
          <circle cx="${x+NR-5}" cy="${y-NR+5}" r="9" fill="${circleFill}" stroke="${roadStroke}" stroke-width="1"/>
          <text x="${x+NR-5}" y="${y-NR+5}" text-anchor="middle" dominant-baseline="middle" font-size="9">🔒</text>` : '';
        const inner = `
          ${pulse}
          <circle cx="${x}" cy="${y}" r="${NR+3}" fill="${circleFill}"/>
          <circle cx="${x}" cy="${y}" r="${NR}" fill="${th.fill}"/>
          <text x="${x}" y="${y}" text-anchor="middle" dominant-baseline="middle"
            font-size="${fontSize}" font-weight="800" fill="${th.text}" font-family="system-ui,sans-serif">${icon}</text>
          ${lockBadge}
          ${nameEls}
          ${badgeEl}`;
        const href = isSkillPath ? `/skills/${c.slug}` : `/courses/${c.slug}`;
        const onclick = isSkillPath
          ? `onclick="localStorage.setItem('skillReturnPath','${p.slug}')"`
          : `onclick="localStorage.setItem('courseReturnTo','/my-paths');localStorage.setItem('courseReturnPath','${p.slug}')"`;
        nodesSVG += isLocked
          ? `<g>${inner}</g>`
          : `<a href="${href}" ${onclick} class="cursor-pointer">${inner}</a>`;
      });

      const svgEl = `<svg width="100%" viewBox="0 0 ${VB_W} ${VB_H}" xmlns="http://www.w3.org/2000/svg">
        <path d="${grayD}" fill="none" stroke="${roadStroke}" stroke-width="${ROAD}" stroke-linecap="round" stroke-linejoin="round"/>
        ${progD ? `<path d="${progD}" fill="none" stroke="${progCol}" stroke-width="${ROAD}" stroke-linecap="round" stroke-linejoin="round"/>` : ''}
        ${nodesSVG}
      </svg>`;

      const pBarCls = allDone ? 'bg-good text-good' : 'text-blue';
      return `
        <div>
          <div class="detail-title">${p.title||p.slug}</div>
          ${p.level ? `<div class="my-[.4rem]">${levelBadge(p.level)}</div>` : ''}
          ${p.description?`<div class="detail-desc">${p.description}</div>`:''}
          ${p.skills?.length && !isSkillPath ? `<div class="flex flex-wrap gap-[.3rem] my-[.4rem]">${(p.skills as string[]).map(sk=>`<a href="/skills/${sk}" class="badge badge-purple text-[.65rem] no-underline" onclick="localStorage.setItem('skillReturnPath','${p.slug}')">🎯 ${sk}</a>`).join('')}</div>` : ''}
          <div class="detail-prog">
            <div class="progress-bar flex-1">
              <div class="progress-bar-fill ${pBarCls}" style="width:${pct}%"></div>
            </div>
            <span class="detail-prog-pct ${pBarCls}">${pct}%</span>
            <span>${done}/${total} ${isSkillPath ? `compétence${total>1?'s':''}` : `cours`}</span>
          </div>
        </div>
        <div class="snake-wrap">${svgEl}</div>
        ${allDone?'<div class="text-center py-2.5 text-base font-bold text-good">🏆 Parcours terminé !</div>':''}`;
    }

    function showList() {
      document.getElementById('view-list')!.classList.remove('hidden');
      document.getElementById('view-detail')!.classList.add('hidden');
      window.scrollTo({ top:0, behavior:'smooth' });
    }
    function showDetail(slug: string) {
      const p = allPaths.find((x:any)=>x.slug===slug);
      if (!p) return;
      document.getElementById('detail-content')!.innerHTML = renderDetail(p);
      document.getElementById('view-list')!.classList.add('hidden');
      document.getElementById('view-detail')!.classList.remove('hidden');
      window.scrollTo({ top:0, behavior:'smooth' });
    }

    async function init() {
      if (!token) return;
      try {
        const res = await fetch('/api/my/paths', { headers: { Authorization:`Bearer ${token}` } });
        if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; return; }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const { paths } = await res.json() as { paths: any[] };
        allPaths = paths ?? [];
        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('mp-content')!.classList.remove('hidden');
        const sub = document.getElementById('mp-sub');
        if (sub) sub.textContent = `${allPaths.length} parcours en cours`;
        if (!allPaths.length) {
          document.getElementById('mp-empty')!.classList.remove('hidden');
          return;
        }
        const list = document.getElementById('mp-list')!;
        list.innerHTML = renderList();
        list.querySelectorAll<HTMLElement>('.path-list-card').forEach(card => {
          card.addEventListener('click', () => showDetail(card.dataset.slug!));
        });
        document.getElementById('btn-back')!.addEventListener('click', showList);

        const returnPath = localStorage.getItem('courseReturnPath') ?? localStorage.getItem('skillReturnPath');
        if (returnPath) {
          localStorage.removeItem('courseReturnPath');
          localStorage.removeItem('skillReturnPath');
          showDetail(returnPath);
        }
      } catch {
        document.getElementById('loading')!.classList.add('hidden');
        (window as any).showToast?.('Erreur lors du chargement des parcours', 'error');
      }
    }

    init();
  </script>
</App>
