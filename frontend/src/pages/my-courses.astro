---
import App from '../layouts/App.astro';
---
<App title="Mes cours" activePage="courses">
  <div class="page-outer">
  <div class="page-inner">
    <div class="flex items-baseline justify-between gap-4 mb-7 flex-wrap">
      <h1 class="page-title">Mes cours</h1>
      <a href="/courses" class="btn btn-secondary btn-sm">Parcourir le catalogue</a>
    </div>

    <div id="loading" class="loading-state"><div class="spinner"></div><span>Chargement…</span></div>

    <div id="mc-content" class="hidden">
      <div class="flex gap-4 flex-wrap mb-7" id="mc-stats"></div>

      <div class="flex items-center gap-3 mb-5 flex-wrap" id="mc-filter-bar">
        <div class="relative flex-1 min-w-[180px] sm:min-w-0">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-soft pointer-events-none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input class="input pl-9" type="search" id="search-input" placeholder="Filtrer mes cours…" />
        </div>
        <select class="input w-auto shrink-0" id="filter-progress">
          <option value="all">Tous</option>
          <option value="in-progress">En cours</option>
          <option value="completed">Terminés</option>
          <option value="not-started">Non commencés</option>
        </select>
        <span class="text-[.875rem] text-ink-soft whitespace-nowrap" id="results-count"></span>
      </div>

      <div id="mc-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[18px]"></div>

      <div id="mc-filter-empty" class="hidden text-center py-10 text-ink-soft">
        <div class="text-[2rem] mb-2.5">🔍</div>
        <p>Aucun cours ne correspond à votre recherche.</p>
      </div>

      <div id="mc-empty" class="hidden text-center py-20 px-6">
        <div class="text-[3.5rem] mb-4">📚</div>
        <h2 class="text-[1.2rem] mb-2">Vous n'êtes inscrit à aucun cours</h2>
        <p class="text-ink-soft text-[.9rem] mb-5">Commencez par parcourir le catalogue et inscrivez-vous à vos premiers cours.</p>
        <a href="/courses" class="btn btn-primary">Découvrir le catalogue</a>
      </div>
    </div>
  </div>
  </div>

  <script>
    const token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/my-courses'; }

    async function apiFetch(path: string, opts: { method?: string; body?: unknown; token?: string } = {}) {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (opts.token) headers['Authorization'] = `Bearer ${opts.token}`;
      const res = await fetch('/api' + path, {
        method: opts.method || 'GET',
        headers,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      });
      if (res.status === 401) { localStorage.clear(); window.location.href = '/login'; throw new Error('Session expirée'); }
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error((err as any).error || `HTTP ${res.status}`); }
      return res.json();
    }

    let allCourses: any[] = [];
    let searchTimer: ReturnType<typeof setTimeout>;

    // Clamped at 100: a course can lose modules after a learner has already
    // completed them, which would otherwise render a progress bar past full.
    function pct(c: any) {
      if (!c.labCount || c.labCount <= 0) return 0;
      return Math.min(100, Math.round(c.completedLabs / c.labCount * 100));
    }

    function courseStatus(c: any): 'not-started' | 'in-progress' | 'completed' {
      const p = pct(c);
      if (p === 0) return 'not-started';
      if (p === 100) return 'completed';
      return 'in-progress';
    }

    function renderCard(c: any): string {
      const p = pct(c);
      const status = courseStatus(c);
      const ctaLabel = status === 'not-started' ? 'Commencer ▸' : status === 'completed' ? 'Revoir ▸' : 'Continuer ▸';
      const thumb = c.thumbnail
        ? `<img src="${c.thumbnail}" alt="${c.title}" class="w-full h-full object-cover" />`
        : '📖';
      const statusBadge = status === 'completed'
        ? `<span class="badge badge-green text-[.7rem]">✓ Terminé</span>`
        : status === 'in-progress'
        ? `<span class="badge badge-blue text-[.7rem]">En cours</span>`
        : `<span class="badge badge-gray text-[.7rem]">Non commencé</span>`;

      return `
        <div class="glass-card flex flex-col transition-[border-color,box-shadow,transform] duration-150 hover:-translate-y-[3px]">
          <div class="course-card-thumb w-full overflow-hidden border-b-[1.5px] border-line shrink-0">${thumb}</div>
          <div class="p-4 flex flex-col gap-2.5 flex-1">
            <div class="flex items-start justify-between gap-2">
              <div class="font-semibold text-[.95rem] leading-snug line-clamp-2">${c.title}</div>
              ${statusBadge}
            </div>
            <div class="flex items-center gap-2">
              <div class="progress-bar flex-1"><div class="progress-bar-fill" style="width:${p}%"></div></div>
              <span class="text-[.75rem] font-semibold text-blue shrink-0 min-w-[32px] text-right">${p}%</span>
            </div>
            <div class="text-[.78rem] text-ink-soft">${Math.min(c.completedLabs ?? 0, c.labCount ?? 0)}/${c.labCount ?? 0} modules terminés</div>
            <div class="mt-auto flex gap-2">
              <a href="/courses/${c.slug || c.id}" class="btn btn-primary btn-sm flex-1 justify-center">${ctaLabel}</a>
              <a href="/courses/${c.slug || c.id}" class="btn btn-secondary btn-sm">Détails</a>
            </div>
          </div>
        </div>
      `;
    }

    function applyFilters() {
      const q = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase().trim();
      const prog = (document.getElementById('filter-progress') as HTMLSelectElement).value;

      let filtered = allCourses;
      if (q) filtered = filtered.filter(c => c.title.toLowerCase().includes(q) || (c.description || '').toLowerCase().includes(q));
      if (prog !== 'all') filtered = filtered.filter(c => courseStatus(c) === prog);

      const grid = document.getElementById('mc-grid')!;
      const filterEmpty = document.getElementById('mc-filter-empty')!;
      document.getElementById('results-count')!.textContent = `${filtered.length} cours`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        filterEmpty.classList.remove('hidden');
      } else {
        filterEmpty.classList.add('hidden');
        grid.innerHTML = filtered.map(renderCard).join('');
      }
    }

    async function init() {
      if (!token) return;
      try {
        const res = await apiFetch('/my/courses', { token: token! }) as any;
        allCourses = res.courses || [];

        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('mc-content')!.classList.remove('hidden');

        if (allCourses.length === 0) {
          document.getElementById('mc-empty')!.classList.remove('hidden');
          document.getElementById('mc-stats')!.classList.add('hidden');
          document.getElementById('mc-filter-bar')!.classList.add('hidden');
          return;
        }

        const totalModules = allCourses.reduce((s: number, c: any) => s + (c.labCount || 0), 0);
        const doneModules = allCourses.reduce(
          (s: number, c: any) => s + Math.min(c.completedLabs || 0, c.labCount || 0), 0);
        const completedCourses = allCourses.filter(c => courseStatus(c) === 'completed').length;
        document.getElementById('mc-stats')!.innerHTML = `
          <div class="stat-card"><span class="stat-val">${allCourses.length}</span><span class="stat-label">cours inscrits</span></div>
          <div class="stat-card"><span class="stat-val">${completedCourses}</span><span class="stat-label">cours terminés</span></div>
          <div class="stat-card"><span class="stat-val">${doneModules}</span><span class="stat-label">modules terminés</span></div>
          <div class="stat-card"><span class="stat-val">${totalModules > 0 ? Math.min(100, Math.round(doneModules / totalModules * 100)) : 0}%</span><span class="stat-label">progression globale</span></div>
        `;

        applyFilters();

        document.getElementById('search-input')!.addEventListener('input', () => {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(applyFilters, 250);
        });
        document.getElementById('filter-progress')!.addEventListener('change', applyFilters);
      } catch {
        document.getElementById('loading')!.classList.add('hidden');
        (window as any).showToast?.('Erreur lors du chargement', 'error');
      }
    }

    init();
  </script>
</App>
