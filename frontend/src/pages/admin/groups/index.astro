---
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Groupes">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:36px;flex-wrap:wrap;gap:16px">
    <div>
      <h1 style="font-size:1.5rem">Groupes</h1>
      <p class="text-soft text-sm" style="margin-top:6px">Groupes synchronisés depuis les providers SSO/LDAP et groupes locaux</p>
    </div>
    <button class="btn btn-primary" id="new-group-btn">+ Nouveau groupe</button>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start">

    <!-- Groups tree -->
    <div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
        <h2 style="font-size:1.1rem">Groupes <span id="groups-count" class="badge badge-gray" style="margin-left:6px"></span></h2>
      </div>
      <div class="card" style="padding:0;overflow:hidden">
        <div id="groups-list">
          <div class="loading-state" style="padding:24px"><div class="spinner"></div></div>
        </div>
      </div>
    </div>

    <!-- Role mappings -->
    <div>
      <div style="margin-bottom:18px">
        <h2 style="font-size:1.1rem">Mappings de rôles</h2>
      </div>
      <div class="card" style="padding:0;overflow:hidden;margin-bottom:20px">
        <div id="mappings-list">
          <div class="loading-state" style="padding:24px"><div class="spinner"></div></div>
        </div>
      </div>
      <div class="card">
        <h3 style="font-size:.95rem;margin-bottom:14px">Ajouter un mapping</h3>
        <div class="stack" style="gap:10px">
          <div class="form-group">
            <label class="label">Nom du groupe SSO</label>
            <input id="new-group-name" class="input" placeholder="ex : devops-team" />
          </div>
          <div class="form-group">
            <label class="label">Rôle plateforme</label>
            <select id="new-group-role" class="input" style="height:auto;padding:9px 14px">
              <option value="student">Étudiant</option>
              <option value="manager">Manager de groupe</option>
              <option value="admin">Administrateur</option>
            </select>
          </div>
          <button class="btn btn-primary btn-sm" id="add-mapping-btn" style="align-self:flex-start">Ajouter</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Create root group modal -->
  <div id="create-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
    <div class="card" style="width:380px;max-width:95vw;padding:28px">
      <h3 style="margin-bottom:20px">Nouveau groupe local</h3>
      <div class="form-group" style="margin-bottom:20px">
        <label class="label">Nom du groupe</label>
        <input id="create-group-name" class="input" placeholder="ex : equipe-rh" />
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button class="btn btn-secondary" id="create-cancel">Annuler</button>
        <button class="btn btn-primary" id="create-confirm">Créer</button>
      </div>
    </div>
  </div>

  <!-- Edit group modal -->
  <div id="edit-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
    <div class="card" style="width:380px;max-width:95vw;padding:28px">
      <h3 style="margin-bottom:20px">Renommer le groupe</h3>
      <div class="form-group" style="margin-bottom:20px">
        <label class="label">Nouveau nom</label>
        <input id="edit-group-name" class="input" placeholder="ex : equipe-rh" />
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button class="btn btn-secondary" id="edit-cancel">Annuler</button>
        <button class="btn btn-primary" id="edit-confirm">Enregistrer</button>
      </div>
    </div>
  </div>

  <!-- Create subgroup modal -->
  <div id="subgroup-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
    <div class="card" style="width:380px;max-width:95vw;padding:28px">
      <h3 style="margin-bottom:6px">Nouveau sous-groupe</h3>
      <p id="subgroup-modal-parent" class="text-soft text-sm" style="margin-bottom:20px"></p>
      <div class="form-group" style="margin-bottom:20px">
        <label class="label">Nom du sous-groupe</label>
        <input id="subgroup-name" class="input" placeholder="ex : equipe-backend" />
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button class="btn btn-secondary" id="subgroup-cancel">Annuler</button>
        <button class="btn btn-primary" id="subgroup-confirm">Créer</button>
      </div>
    </div>
  </div>

  <!-- Move group modal -->
  <div id="move-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
    <div class="card" style="width:420px;max-width:95vw;padding:28px">
      <h3 style="margin-bottom:6px">Déplacer le groupe</h3>
      <p id="move-modal-name" class="text-soft text-sm" style="margin-bottom:20px"></p>
      <div class="form-group" style="margin-bottom:20px">
        <label class="label">Nouveau parent</label>
        <select id="move-parent-select" class="input" style="height:auto;padding:9px 14px">
          <option value="">Racine (aucun parent)</option>
        </select>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button class="btn btn-secondary" id="move-cancel">Annuler</button>
        <button class="btn btn-primary" id="move-confirm">Déplacer</button>
      </div>
    </div>
  </div>

  <!-- Members modal -->
  <div id="members-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
    <div class="card" style="width:520px;max-width:95vw;padding:28px;max-height:90vh;overflow-y:auto">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
        <h3 id="members-modal-title">Membres du groupe</h3>
        <button id="members-close" style="background:none;border:none;cursor:pointer;font-size:1.25rem;color:var(--ink-soft)">✕</button>
      </div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
        <input type="checkbox" id="recursive-toggle" style="cursor:pointer" />
        <label for="recursive-toggle" style="font-size:.82rem;cursor:pointer;color:var(--ink-soft)">Inclure les membres des sous-groupes</label>
      </div>
      <div style="margin-bottom:20px">
        <h4 style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin-bottom:10px">Membres actuels</h4>
        <div id="members-list">
          <div class="loading-state" style="padding:12px 0"><div class="spinner" style="width:20px;height:20px"></div></div>
        </div>
      </div>
      <div style="border-top:1px solid var(--line);padding-top:20px">
        <h4 style="font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-soft);margin-bottom:10px">Ajouter un membre</h4>
        <div style="display:flex;gap:8px">
          <select id="add-member-select" class="input" style="flex:1;height:auto;padding:9px 14px">
            <option value="">Choisir un utilisateur…</option>
          </select>
          <button class="btn btn-primary" id="add-member-btn">Ajouter</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ── API helper ────────────────────────────────────────────────────────────
    async function api(path: string, opts: { method?: string; body?: unknown } = {}) {
      const token = localStorage.getItem('token');
      const headers: Record<string, string> = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };
      const res = await fetch('/api' + path, { method: opts.method || 'GET', headers, body: opts.body ? JSON.stringify(opts.body) : undefined });
      if (!res.ok) { const e = await res.json().catch(() => ({})); throw new Error((e as any).error || `HTTP ${res.status}`); }
      return res.status === 204 ? null : res.json();
    }

    // ── State ─────────────────────────────────────────────────────────────────
    let allGroups: any[] = [];
    let allUsers: any[] = [];
    let selectedGroupId = '';
    let subgroupParentId = '';
    let moveGroupId = '';
    let editGroupId = '';
    let membersRecursive = false;
    const expanded = new Set<string>();

    // ── Tree helpers ──────────────────────────────────────────────────────────
    interface GroupNode {
      id: string; name: string; source: string;
      parentId: string; depth: number;
      memberCount: number; mappedRole: string;
      children: GroupNode[];
    }

    function buildTree(flat: any[]): GroupNode[] {
      const byId = new Map<string, GroupNode>();
      for (const g of flat) {
        byId.set(g.id, { ...g, parentId: g.parentId ?? '', children: [] });
      }
      const roots: GroupNode[] = [];
      for (const g of flat) {
        const node = byId.get(g.id)!;
        if (g.parentId && byId.has(g.parentId)) {
          byId.get(g.parentId)!.children.push(node);
        } else {
          roots.push(node);
        }
      }
      return roots;
    }

    function collectDescendantIds(node: GroupNode): Set<string> {
      const ids = new Set<string>();
      function walk(n: GroupNode) { ids.add(n.id); n.children.forEach(walk); }
      walk(node);
      return ids;
    }

    // ── Render tree ───────────────────────────────────────────────────────────
    function renderNode(node: GroupNode, indent: number): string {
      const isExpanded = expanded.has(node.id);
      const hasChildren = node.children.length > 0;
      const isLocal = node.source === 'local';
      const isDefault = node.name === 'everyone';
      const indentPx = indent * 20;

      const toggleBtn = hasChildren
        ? `<button class="toggle-btn" data-id="${node.id}" style="background:none;border:none;cursor:pointer;font-size:.75rem;color:var(--ink-soft);padding:2px 4px;flex-shrink:0">${isExpanded ? '▼' : '▶'}</button>`
        : `<span style="display:inline-block;width:22px;flex-shrink:0"></span>`;

      const roleBadge = node.mappedRole
        ? `<span class="badge ${node.mappedRole === 'admin' ? 'badge-red' : node.mappedRole === 'manager' ? 'badge-orange' : 'badge-blue'}">${node.mappedRole}</span>`
        : (node.source !== 'local' ? '<span class="badge badge-gray">Non mappé</span>' : '');

      const actions = [
        `<button class="btn btn-secondary btn-sm members-btn" data-id="${node.id}" data-name="${node.name}" style="flex-shrink:0">Membres</button>`,
        isLocal && !isDefault ? `<button class="btn btn-secondary btn-sm subgroup-btn" data-id="${node.id}" data-name="${node.name}" style="flex-shrink:0" title="Créer un sous-groupe">+</button>` : '',
        isLocal && !isDefault ? `<button class="btn btn-secondary btn-sm edit-group-btn" data-id="${node.id}" data-name="${node.name}" style="flex-shrink:0" title="Renommer">✎</button>` : '',
        isLocal && !isDefault ? `<button class="btn btn-secondary btn-sm move-btn" data-id="${node.id}" data-name="${node.name}" style="flex-shrink:0" title="Déplacer">⇄</button>` : '',
        isLocal && !isDefault ? `<button class="btn btn-sm del-group-btn" style="background:var(--bad-soft);color:var(--bad);flex-shrink:0" data-id="${node.id}" data-name="${node.name}">✕</button>` : '',
      ].filter(Boolean).join('');

      const row = `
        <div class="group-row" data-id="${node.id}" style="display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--line);padding-left:${indentPx + 20}px">
          ${toggleBtn}
          <div style="flex:1;min-width:0">
            <div style="font-weight:500;font-size:.875rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${node.name}</div>
            <div style="font-size:.75rem;color:var(--ink-soft)">${node.memberCount} membre${node.memberCount !== 1 ? 's' : ''}${node.source !== 'local' ? ' · <span class="badge badge-orange" style="font-size:.7rem;padding:1px 5px">' + node.source + '</span>' : ''}${node.depth > 0 ? ' · <span class="badge badge-gray" style="font-size:.7rem;padding:1px 5px">sous-groupe</span>' : ''}</div>
          </div>
          ${roleBadge}
          ${actions}
        </div>`;

      const children = (isExpanded && hasChildren)
        ? node.children.map(child => renderNode(child, indent + 1)).join('')
        : '';

      return row + children;
    }

    function renderTree(roots: GroupNode[]) {
      return roots.map(n => renderNode(n, 0)).join('');
    }

    // ── Load & display groups ─────────────────────────────────────────────────
    async function loadGroups() {
      try {
        const { groups } = await api('/admin/groups');
        allGroups = groups || [];
        document.getElementById('groups-count')!.textContent = String(allGroups.length);
        renderGroupsList();
      } catch (e: any) {
        document.getElementById('groups-list')!.innerHTML = `<p style="color:var(--bad);padding:16px">${e.message}</p>`;
      }
    }

    function renderGroupsList() {
      const el = document.getElementById('groups-list')!;
      if (!allGroups.length) {
        el.innerHTML = '<p class="text-soft text-sm" style="padding:16px">Aucun groupe.</p>';
        return;
      }
      const roots = buildTree(allGroups);
      el.innerHTML = renderTree(roots);

      el.querySelectorAll<HTMLButtonElement>('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id!;
          if (expanded.has(id)) expanded.delete(id); else expanded.add(id);
          renderGroupsList();
        });
      });
      el.querySelectorAll<HTMLButtonElement>('.members-btn').forEach(btn => {
        btn.addEventListener('click', () => openMembers(btn.dataset.id!, btn.dataset.name!));
      });
      el.querySelectorAll<HTMLButtonElement>('.subgroup-btn').forEach(btn => {
        btn.addEventListener('click', () => openSubgroupModal(btn.dataset.id!, btn.dataset.name!));
      });
      el.querySelectorAll<HTMLButtonElement>('.edit-group-btn').forEach(btn => {
        btn.addEventListener('click', () => openEditModal(btn.dataset.id!, btn.dataset.name!));
      });
      el.querySelectorAll<HTMLButtonElement>('.move-btn').forEach(btn => {
        btn.addEventListener('click', () => openMoveModal(btn.dataset.id!, btn.dataset.name!));
      });
      el.querySelectorAll<HTMLButtonElement>('.del-group-btn').forEach(btn => {
        btn.addEventListener('click', () => deleteGroup(btn.dataset.id!, btn.dataset.name!));
      });
    }

    // ── Delete group ──────────────────────────────────────────────────────────
    async function deleteGroup(id: string, name: string) {
      if (!confirm(`Supprimer le groupe "${name}" ? Cette action est irréversible.`)) return;
      try {
        await api(`/admin/groups/${id}`, { method: 'DELETE' });
        (window as any).showToast?.('Groupe supprimé', 'success');
        await loadGroups();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      }
    }

    // ── Subgroup creation ─────────────────────────────────────────────────────
    function openSubgroupModal(parentId: string, parentName: string) {
      subgroupParentId = parentId;
      document.getElementById('subgroup-modal-parent')!.textContent = `Sous-groupe de : ${parentName}`;
      (document.getElementById('subgroup-name') as HTMLInputElement).value = '';
      document.getElementById('subgroup-modal')!.style.display = 'flex';
    }

    document.getElementById('subgroup-cancel')!.addEventListener('click', () => {
      document.getElementById('subgroup-modal')!.style.display = 'none';
    });
    document.getElementById('subgroup-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('subgroup-modal')) document.getElementById('subgroup-modal')!.style.display = 'none';
    });
    document.getElementById('subgroup-confirm')!.addEventListener('click', async () => {
      const name = (document.getElementById('subgroup-name') as HTMLInputElement).value.trim();
      if (!name) { (window as any).showToast?.('Nom requis', 'error'); return; }
      const btn = document.getElementById('subgroup-confirm') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api(`/admin/groups/${subgroupParentId}/subgroups`, { method: 'POST', body: { name } });
        expanded.add(subgroupParentId);
        document.getElementById('subgroup-modal')!.style.display = 'none';
        (window as any).showToast?.('Sous-groupe créé', 'success');
        await loadGroups();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Créer';
      }
    });

    // ── Edit group ────────────────────────────────────────────────────────────
    function openEditModal(groupId: string, currentName: string) {
      editGroupId = groupId;
      (document.getElementById('edit-group-name') as HTMLInputElement).value = currentName;
      document.getElementById('edit-modal')!.style.display = 'flex';
    }

    document.getElementById('edit-cancel')!.addEventListener('click', () => {
      document.getElementById('edit-modal')!.style.display = 'none';
    });
    document.getElementById('edit-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('edit-modal')) document.getElementById('edit-modal')!.style.display = 'none';
    });
    document.getElementById('edit-confirm')!.addEventListener('click', async () => {
      const name = (document.getElementById('edit-group-name') as HTMLInputElement).value.trim();
      if (!name) { (window as any).showToast?.('Nom requis', 'error'); return; }
      const btn = document.getElementById('edit-confirm') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api(`/admin/groups/${editGroupId}`, { method: 'PUT', body: { name } });
        document.getElementById('edit-modal')!.style.display = 'none';
        (window as any).showToast?.('Groupe renommé', 'success');
        await loadGroups();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Enregistrer';
      }
    });

    // ── Move group ────────────────────────────────────────────────────────────
    function openMoveModal(groupId: string, groupName: string) {
      moveGroupId = groupId;
      document.getElementById('move-modal-name')!.textContent = `Groupe : ${groupName}`;

      // Build descendant set to exclude from parent options
      const roots = buildTree(allGroups);
      function findNode(nodes: GroupNode[], id: string): GroupNode | null {
        for (const n of nodes) { if (n.id === id) return n; const f = findNode(n.children, id); if (f) return f; }
        return null;
      }
      const node = findNode(roots, groupId);
      const excluded = node ? collectDescendantIds(node) : new Set([groupId]);

      const sel = document.getElementById('move-parent-select') as HTMLSelectElement;
      sel.innerHTML = '<option value="">Racine (aucun parent)</option>' +
        allGroups
          .filter(g => !excluded.has(g.id))
          .map(g => `<option value="${g.id}">${'—'.repeat(g.depth)} ${g.name}</option>`)
          .join('');

      document.getElementById('move-modal')!.style.display = 'flex';
    }

    document.getElementById('move-cancel')!.addEventListener('click', () => {
      document.getElementById('move-modal')!.style.display = 'none';
    });
    document.getElementById('move-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('move-modal')) document.getElementById('move-modal')!.style.display = 'none';
    });
    document.getElementById('move-confirm')!.addEventListener('click', async () => {
      const parentId = (document.getElementById('move-parent-select') as HTMLSelectElement).value || null;
      const btn = document.getElementById('move-confirm') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api(`/admin/groups/${moveGroupId}/parent`, { method: 'PATCH', body: { parentId } });
        if (parentId) expanded.add(parentId);
        document.getElementById('move-modal')!.style.display = 'none';
        (window as any).showToast?.('Groupe déplacé', 'success');
        await loadGroups();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Déplacer';
      }
    });

    // ── Members modal ─────────────────────────────────────────────────────────
    document.getElementById('recursive-toggle')!.addEventListener('change', async (e) => {
      membersRecursive = (e.target as HTMLInputElement).checked;
      await refreshMembers();
    });

    async function openMembers(groupId: string, groupName: string) {
      selectedGroupId = groupId;
      membersRecursive = false;
      (document.getElementById('recursive-toggle') as HTMLInputElement).checked = false;
      document.getElementById('members-modal-title')!.textContent = `Membres — ${groupName}`;
      document.getElementById('members-modal')!.style.display = 'flex';
      await refreshMembers();
      if (!allUsers.length) {
        try { const r = await api('/admin/users'); allUsers = r.users || []; } catch { /* ignore */ }
      }
      const sel = document.getElementById('add-member-select') as HTMLSelectElement;
      sel.innerHTML = '<option value="">Choisir un utilisateur…</option>' +
        allUsers.map((u: any) => `<option value="${u.id}">${u.username} (${u.email})</option>`).join('');
    }

    async function refreshMembers() {
      const el = document.getElementById('members-list')!;
      el.innerHTML = '<div class="loading-state" style="padding:12px 0"><div class="spinner" style="width:20px;height:20px"></div></div>';
      const suffix = membersRecursive ? '?recursive=true' : '';
      try {
        const { members } = await api(`/admin/groups/${selectedGroupId}/members${suffix}`);
        const list: any[] = members || [];
        if (!list.length) { el.innerHTML = '<p class="text-soft text-sm">Aucun membre.</p>'; return; }
        el.innerHTML = list.map((u: any) => {
          const memberBadge = membersRecursive
            ? `<span class="badge ${u.directMembership ? 'badge-blue' : 'badge-gray'}" style="flex-shrink:0;font-size:.7rem">${u.directMembership ? 'Direct' : 'Hérité'}</span>`
            : '';
          return `
          <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)">
            <div style="width:30px;height:30px;border-radius:50%;background:var(--blue-soft);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.78rem;color:var(--blue);flex-shrink:0">${(u.username||'?')[0].toUpperCase()}</div>
            <div style="flex:1;min-width:0">
              <div style="font-size:.875rem;font-weight:500">${u.username}</div>
              <div style="font-size:.75rem;color:var(--ink-soft)">${u.email}</div>
            </div>
            ${memberBadge}
            <span class="badge ${u.role === 'admin' ? 'badge-red' : u.role === 'manager' ? 'badge-orange' : 'badge-blue'}" style="flex-shrink:0">${u.role}</span>
            <button class="btn btn-sm remove-member-btn" style="background:var(--bad-soft);color:var(--bad);flex-shrink:0" data-uid="${u.id}">Retirer</button>
          </div>`;
        }).join('');
        el.querySelectorAll<HTMLButtonElement>('.remove-member-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            try {
              await api(`/admin/groups/${selectedGroupId}/members/${btn.dataset.uid}`, { method: 'DELETE' });
              (window as any).showToast?.('Membre retiré', 'success');
              await refreshMembers(); loadGroups();
            } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
          });
        });
      } catch (e: any) {
        el.innerHTML = `<p style="color:var(--bad);font-size:.875rem">${e.message}</p>`;
      }
    }

    document.getElementById('add-member-btn')!.addEventListener('click', async () => {
      const userId = (document.getElementById('add-member-select') as HTMLSelectElement).value;
      if (!userId) { (window as any).showToast?.('Choisissez un utilisateur', 'error'); return; }
      const btn = document.getElementById('add-member-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api(`/admin/groups/${selectedGroupId}/members`, { method: 'POST', body: { userId } });
        (document.getElementById('add-member-select') as HTMLSelectElement).value = '';
        (window as any).showToast?.('Membre ajouté', 'success');
        await refreshMembers(); loadGroups();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Ajouter';
      }
    });

    document.getElementById('members-close')!.addEventListener('click', () => {
      document.getElementById('members-modal')!.style.display = 'none';
    });
    document.getElementById('members-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('members-modal')) document.getElementById('members-modal')!.style.display = 'none';
    });

    // ── Create root group ─────────────────────────────────────────────────────
    document.getElementById('new-group-btn')!.addEventListener('click', () => {
      (document.getElementById('create-group-name') as HTMLInputElement).value = '';
      document.getElementById('create-modal')!.style.display = 'flex';
    });
    document.getElementById('create-cancel')!.addEventListener('click', () => {
      document.getElementById('create-modal')!.style.display = 'none';
    });
    document.getElementById('create-modal')!.addEventListener('click', (e) => {
      if (e.target === document.getElementById('create-modal')) document.getElementById('create-modal')!.style.display = 'none';
    });
    document.getElementById('create-confirm')!.addEventListener('click', async () => {
      const name = (document.getElementById('create-group-name') as HTMLInputElement).value.trim();
      if (!name) { (window as any).showToast?.('Nom requis', 'error'); return; }
      const btn = document.getElementById('create-confirm') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = '…';
      try {
        await api('/admin/groups', { method: 'POST', body: { name } });
        document.getElementById('create-modal')!.style.display = 'none';
        (window as any).showToast?.('Groupe créé', 'success');
        await loadGroups();
      } catch (e: any) {
        (window as any).showToast?.(e.message || 'Erreur', 'error');
      } finally {
        btn.disabled = false; btn.textContent = 'Créer';
      }
    });

    // ── Mappings ──────────────────────────────────────────────────────────────
    async function loadMappings() {
      try {
        const { mappings } = await api('/admin/groups/mappings');
        const el = document.getElementById('mappings-list')!;
        if (!mappings.length) { el.innerHTML = '<p class="text-soft text-sm" style="padding:20px">Aucun mapping défini.</p>'; return; }
        el.innerHTML = mappings.map((m: any) => `
          <div style="display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--line)">
            <code style="flex:1;font-size:.82rem;background:var(--fill);padding:3px 7px;border-radius:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${m.groupName}</code>
            <span style="color:var(--ink-soft);flex-shrink:0">→</span>
            <span class="badge ${m.platformRole === 'admin' ? 'badge-red' : m.platformRole === 'manager' ? 'badge-orange' : 'badge-blue'}" style="flex-shrink:0">${m.platformRole}</span>
            <button class="btn btn-sm del-mapping-btn" style="background:var(--bad-soft);color:var(--bad);flex-shrink:0" data-group="${m.groupName}">✕</button>
          </div>`).join('');
        el.querySelectorAll<HTMLButtonElement>('.del-mapping-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            try {
              await api(`/admin/groups/mappings/${encodeURIComponent(btn.dataset.group!)}`, { method: 'DELETE' });
              loadMappings(); loadGroups();
              (window as any).showToast?.('Mapping supprimé', 'success');
            } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
          });
        });
      } catch (e: any) {
        document.getElementById('mappings-list')!.innerHTML = `<p style="color:var(--bad);padding:16px">${e.message}</p>`;
      }
    }

    document.getElementById('add-mapping-btn')!.addEventListener('click', async () => {
      const groupName = (document.getElementById('new-group-name') as HTMLInputElement).value.trim();
      const role = (document.getElementById('new-group-role') as HTMLSelectElement).value;
      if (!groupName) { (window as any).showToast?.('Nom du groupe requis', 'error'); return; }
      try {
        await api('/admin/groups/mappings', { method: 'POST', body: { groupName, platformRole: role } });
        (document.getElementById('new-group-name') as HTMLInputElement).value = '';
        loadMappings(); loadGroups();
        (window as any).showToast?.('Mapping ajouté', 'success');
      } catch (e: any) { (window as any).showToast?.(e.message || 'Erreur', 'error'); }
    });

    // ── Init ──────────────────────────────────────────────────────────────────
    loadGroups();
    loadMappings();
  </script>
</Admin>
