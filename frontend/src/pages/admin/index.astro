---
import Admin from '../../layouts/Admin.astro';
---
<Admin title="Tableau de bord">
  <div>
    <div class="mb-7">
      <h1 class="text-2xl">Tableau de bord</h1>
      <p class="text-soft text-sm mt-1">Vue d'ensemble de la plateforme pupitre</p>
    </div>

    <!-- Stats grid -->
    <div id="stats-grid" class="stats-grid">
      {[0,1,2,3,4,5].map(() => (
        <div class="card-sm text-center p-5">
          <div class="spinner mx-auto mb-2"></div>
          <div class="text-soft text-xs">Chargement…</div>
        </div>
      ))}
    </div>

    <!-- Leaderboard -->
    <div class="card">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-[1.1rem]">Classement</h2>
        <a href="/admin/leaderboard" class="btn btn-secondary btn-sm">Voir tout →</a>
      </div>
      <div id="leaderboard"></div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token');

    async function api(path: string) {
      const res = await fetch('/api' + path, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    const STAT_LABELS: Record<string, { label: string; cls: string }> = {
      total_users:       { label: 'Utilisateurs',    cls: 'text-blue'   },
      totalCourses:      { label: 'Cours',            cls: 'text-blue'   },
      total_labs:        { label: 'Labs',             cls: 'text-blue'   },
      total_enrollments: { label: 'Inscriptions',     cls: 'text-orange' },
      total_submissions: { label: 'Soumissions',      cls: 'text-ink'    },
      success_rate:      { label: 'Taux de réussite', cls: 'text-good'   },
    };

    async function loadStats() {
      const grid = document.getElementById('stats-grid')!;
      try {
        const s = await api('/admin/stats');
        grid.innerHTML = Object.entries(STAT_LABELS).map(([k, { label, cls }]) => `
          <div class="card-sm stat-card">
            <div class="stat-card-value ${cls}">${s[k] ?? '—'}</div>
            <div class="stat-card-label">${label}</div>
          </div>
        `).join('');
      } catch {
        grid.innerHTML = '<div class="text-soft text-sm col-span-full">Statistiques indisponibles</div>';
      }
    }

    async function loadLeaderboard() {
      const el = document.getElementById('leaderboard')!;
      try {
        const { leaderboard } = await api('/admin/leaderboard');
        const top = (leaderboard || []).slice(0, 8);
        if (!top.length) { el.innerHTML = '<p class="text-soft text-sm">Aucune donnée.</p>'; return; }
        el.innerHTML = top.map((e: any, i: number) => `
          <div class="lb-row">
            <span class="lb-rank ${i < 3 ? 'top' : ''}">${i + 1}</span>
            <div class="lb-avatar">${(e.username || '?')[0].toUpperCase()}</div>
            <div class="lb-info">
              <div class="lb-name">${e.username}</div>
              <div class="lb-sub">${e.passedModules} modules · ${e.enrolledCourses} cours</div>
            </div>
            <span class="lb-score">${e.totalScore} pts</span>
          </div>
        `).join('');
      } catch {
        el.innerHTML = '<p class="text-soft text-sm">Classement indisponible.</p>';
      }
    }

    loadStats();
    loadLeaderboard();
  </script>
</Admin>
