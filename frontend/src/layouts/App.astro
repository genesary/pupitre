---
import Base from './Base.astro';

export interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const { title, description, activePage } = Astro.props;
---
<Base title={title} description={description}>
  <nav class="topnav">
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <a href="/courses" class="brand">
      <img src="/pioupitre.png" alt="pioupitre" class="w-8 h-8 object-contain" />
      <span class="brand-font text-[1.3rem] font-bold text-ink">pupitre</span>
    </a>
    <a href="/courses" class={`navlink${activePage === 'catalogue' ? ' active' : ''}`} id="nav-catalogue">Catalogue</a>
    <a href="/my-courses" class={`navlink${activePage === 'courses' ? ' active' : ''}`} id="nav-my-courses">Mes cours</a>
    <a href="/manager/users" class="navlink hidden" id="nav-manager">Mon espace</a>
    <div class="nav-spacer"></div>
    <slot name="nav-extra" />
    <button id="theme-toggle" class="nav-hamburger" aria-label="Basculer le thème" title="Mode sombre / clair">
      <svg id="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg id="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <div id="nav-user" class="flex items-center gap-2">
      <a href="/login" class="btn btn-secondary btn-sm" id="nav-login-link">Se connecter</a>
    </div>
  </nav>

  <!-- Drawer overlay -->
  <div class="nav-drawer-overlay" id="drawer-overlay"></div>

  <!-- Side drawer -->
  <aside class="nav-drawer" id="nav-drawer">
    <div class="nav-drawer-header">
      <span class="brand-font text-2xl font-bold brand-logo-text">pupitre</span>
      <button class="nav-drawer-close" id="drawer-close" aria-label="Fermer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="nav-drawer-body">
      <div class="nav-drawer-section">
        <div class="nav-drawer-label">Mon apprentissage</div>
        <a href="/courses"    class="nav-drawer-link" id="dl-catalogue"><span class="nav-drawer-icon">📚</span>Catalogue</a>
        <a href="/my-courses" class="nav-drawer-link" id="dl-my-courses"><span class="nav-drawer-icon">🎓</span>Mes cours</a>
        <a href="/my-paths"   class="nav-drawer-link" id="dl-paths"><span class="nav-drawer-icon">🗺️</span>Mes parcours</a>
        <a href="/my-groups"  class="nav-drawer-link" id="dl-groups"><span class="nav-drawer-icon">👥</span>Mes groupes</a>
      </div>
      <div class="nav-drawer-section">
        <div class="nav-drawer-label">Progression & Gamification</div>
        <a href="/my-badges"   class="nav-drawer-link" id="dl-badges"><span class="nav-drawer-icon">🏅</span>Mes badges</a>
        <a href="/my-xp"       class="nav-drawer-link" id="dl-xp"><span class="nav-drawer-icon">⚡</span>Mon XP</a>
        <a href="/leaderboard" class="nav-drawer-link" id="dl-leaderboard"><span class="nav-drawer-icon">🏆</span>Classement</a>
      </div>
      <div class="nav-drawer-section">
        <div class="nav-drawer-label">Compétences & Planning</div>
        <a href="/my-skills" class="nav-drawer-link" id="dl-skills"><span class="nav-drawer-icon">🎯</span>Mes compétences</a>
        <a href="/agenda"    class="nav-drawer-link" id="dl-agenda"><span class="nav-drawer-icon">📅</span>Agenda</a>
      </div>
      <div class="nav-drawer-section">
        <button class="nav-drawer-link w-full text-left" id="drawer-theme-toggle"><span class="nav-drawer-icon" id="drawer-theme-icon">🌙</span><span id="drawer-theme-label">Mode sombre</span></button>
        <button class="nav-drawer-link w-full text-left text-bad" id="drawer-logout"><span class="nav-drawer-icon">🚪</span>Déconnexion</button>
      </div>
    </div>
  </aside>

  <!-- Toast container -->
  <div id="toast-container"></div>

  <slot />

  <script>
    // ── Drawer ──────────────────────────────────────────────────────────
    const hamburger = document.getElementById('nav-hamburger');
    const drawer    = document.getElementById('nav-drawer');
    const overlay   = document.getElementById('drawer-overlay');
    const closeBtn  = document.getElementById('drawer-close');

    function openDrawer()  { drawer?.classList.add('open'); overlay?.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeDrawer() { drawer?.classList.remove('open'); overlay?.classList.remove('open'); document.body.style.overflow = ''; }

    hamburger?.addEventListener('click', openDrawer);
    overlay?.addEventListener('click', closeDrawer);
    closeBtn?.addEventListener('click', closeDrawer);

    document.getElementById('drawer-logout')?.addEventListener('click', () => {
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/login';
    });

    // Highlight active drawer link from current path
    const _path = window.location.pathname;
    const _drawerMap: Record<string, string> = {
      '/courses': 'dl-catalogue', '/my-courses': 'dl-my-courses',
      '/my-paths': 'dl-paths', '/my-groups': 'dl-groups',
      '/my-badges': 'dl-badges', '/my-xp': 'dl-xp',
      '/leaderboard': 'dl-leaderboard', '/my-skills': 'dl-skills', '/agenda': 'dl-agenda',
    };
    for (const [href, id] of Object.entries(_drawerMap)) {
      if (_path === href || _path.startsWith(href + '/')) {
        document.getElementById(id)?.classList.add('active');
      }
    }

    // ── Nav user ────────────────────────────────────────────────────────
    function initNav() {
      const raw = localStorage.getItem('user');
      if (!raw) return;
      try {
        const user = JSON.parse(raw);
        const navUser = document.getElementById('nav-user');
        if (!navUser) return;

        const initial = (user.username || '?')[0].toUpperCase();
        const isUrl = user.avatarUrl && (user.avatarUrl.startsWith('http://') || user.avatarUrl.startsWith('https://'));
        let avatarEl: string;
        if (isUrl) {
          avatarEl = `<img src="${user.avatarUrl}" alt="${user.username}" class="nav-avatar" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><div class="nav-avatar-initial hidden">${initial}</div>`;
        } else if (user.avatarUrl) {
          avatarEl = `<div class="nav-avatar-initial text-[1.2rem]">${user.avatarUrl}</div>`;
        } else {
          avatarEl = `<div class="nav-avatar-initial">${initial}</div>`;
        }

        navUser.innerHTML = `
          <a href="/profile" class="flex items-center gap-2 no-underline text-inherit" title="${user.username}">
            ${avatarEl}
            <span class="text-[.875rem] font-medium text-ink-soft max-w-[120px] overflow-hidden text-ellipsis whitespace-nowrap hidden sm:inline">${user.username}</span>
          </a>
          ${user.role === 'admin' ? '<a href="/admin" class="btn btn-sm btn-admin-nav">⚙ Admin</a>' : ''}
          <button id="nav-logout" class="btn btn-ghost btn-sm">Déconnexion</button>
        `;

        if (user.role === 'manager') {
          const managerLink = document.getElementById('nav-manager');
          if (managerLink) managerLink.classList.remove('hidden');
        }

        document.getElementById('nav-logout')?.addEventListener('click', () => {
          localStorage.removeItem('token');
          localStorage.removeItem('user');
          window.location.href = '/login';
        });
      } catch { /* ignore */ }
    }

    initNav();

    // ── Dark mode toggle ────────────────────────────────────────────────
    function isDark() { return document.documentElement.classList.contains('dark'); }

    function updateThemeIcons() {
      const dark = isDark();
      document.getElementById('theme-icon-sun')?.classList.toggle('hidden', !dark);
      document.getElementById('theme-icon-moon')?.classList.toggle('hidden', dark);
      const drawerIcon = document.getElementById('drawer-theme-icon');
      const drawerLabel = document.getElementById('drawer-theme-label');
      if (drawerIcon) drawerIcon.textContent = dark ? '☀️' : '🌙';
      if (drawerLabel) drawerLabel.textContent = dark ? 'Mode clair' : 'Mode sombre';
    }

    function toggleTheme() {
      const dark = isDark();
      document.documentElement.classList.toggle('dark', !dark);
      localStorage.setItem('theme', dark ? 'light' : 'dark');
      updateThemeIcons();
    }

    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
    document.getElementById('drawer-theme-toggle')?.addEventListener('click', toggleTheme);
    updateThemeIcons();

    // Toast system
    window.addEventListener('toast', (e: Event) => {
      const { message, type = 'info' } = (e as CustomEvent).detail;
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;

      const icons: Record<string, string> = {
        info: 'ℹ️', success: '✓', error: '✕', warning: '⚠'
      };

      toast.innerHTML = `<span>${icons[type] ?? 'ℹ️'}</span><span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        toast.style.transition = 'all .25s';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    });

    function showToast(message: string, type = 'info') {
      window.dispatchEvent(new CustomEvent('toast', { detail: { message, type } }));
    }

    (window as any).showToast = showToast;
  </script>
</Base>
