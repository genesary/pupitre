{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":docker",
    ":enableRenovate",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)",
    ":gitSignOff",
    ":gomod",
    ":ignoreModulesAndTests",
    ":labels(deps,source::bot)",
    ":rebaseStalePrs",
    ":renovatePrefix",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    ":semanticCommitType(chore)",
    "group:all",
    "helpers:githubDigestChangelogs",
    "helpers:gitlabDigestChangelogs",
    "helpers:goXPackagesNameLink",
    "helpers:renovateChangelog",
    "mergeConfidence:all-badges",
    "security:openssf-scorecard",
    "workarounds:all"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true
  },
  "updateInternalDeps": true,
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardLabels": [
    "deps",
    "source::bot"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Bump the `go` directive (and `toolchain`, if added) in go.mod to the latest Go release instead of treating it as a minimum floor, so it lands in the same PR as the setup-go `go-version` bump.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
