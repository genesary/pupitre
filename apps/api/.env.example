# Local development settings of pupitre-api, read from apps/api/.env by
# `pnpm api:dev` (which creates .env from this file when it is missing).
# They match compose.yaml. Development values only: never use them anywhere
# else.

PORT=8080
DATABASE_URL=postgres://pupitre:pupitre@localhost:5432/pupitre?sslmode=disable
JWT_SECRET=local-development-jwt-secret-change-me-0123456789
ADMIN_PASSWORD=Local-Admin-Dev-1
CORS_ORIGINS=http://localhost:3000
LOG_FORMAT=text
# Networks whose forwarding headers are believed: the dev server's proxy here.
# Behind an ingress, list the ingress's addresses, not the clients' networks.
TRUSTED_PROXIES=127.0.0.0/8,::1/128

SEED_DEV_COURSES=true
UPLOADS_DIR=./uploads

OIDC_ENABLED=true
OIDC_PROVIDER_URL=http://localhost:8180/realms/pupitre
OIDC_CLIENT_ID=pupitre
OIDC_CLIENT_SECRET=pupitre-local-test-secret
OIDC_REDIRECT_BASE=http://localhost:3000
OIDC_GROUP_CLAIM=groups
OAUTH_REDIRECT_BASE=http://localhost:3000
